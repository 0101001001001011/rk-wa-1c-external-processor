// Отправить текстовое сообщение
//
&НаКлиенте
Процедура Отправить(Команда)
	ОтправитьНаСервере();
	АктивноеОкноCHAT = ПолучитьАктивноеОкно();
	АктивноеОкноCHAT.WhatsAppChatAPI.addOutgoingTextMessage(Сообщение);
	Сообщение = "";
КонецПроцедуры

// Отправить текстовое сообщение
//
&НаСервере
Процедура ОтправитьНаСервере()
	Если Не ПустаяСтрока(Сообщение) Тогда
		ИнтеграцияWhatsApp = ПолучитьОбработкуОбъект();
		ИнтеграцияWhatsApp.ОтправитьСообщение(
			ТекущийИдентификаторЧата,
			Сообщение,
			ИнтеграцияWhatsApp.СоздатьПараметрыСУ(
				ИдентификаторИнстаса,   
				Объект.ТипАутентификации,
				?(Объект.ТипАутентификации = "apiKey", Объект.КлючAPI, Объект.Токен),
				Объект.БазовыйURL,
				Объект.Порт,
				Объект.ИспользоватьSSL,
			)
		);		
	КонецЕсли;
КонецПроцедуры

// Выбрать файл для отправки
//
&НаКлиенте
Процедура ОтправитьФайл(Команда)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = НСтр("ru='All (*.*)|*.*");
	Диалог.Заголовок = НСтр("ru='Выберите файл'");
	ОповещениеЗавершения = Новый ОписаниеОповещения("ВыборФайлаЗавершение", ЭтотОбъект);
	Диалог.Показать(ОповещениеЗавершения);
КонецПроцедуры

// Загрузить файл для отправки
//
&НаКлиенте
Процедура ВыборФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
	ДанынеФайла = Новый ДвоичныеДанные(ВыбранныеФайлы[0]);
	ОтправитьФайлНаСервере(ДанынеФайла,СтрРазделить(ВыбранныеФайлы[0], "\")[СтрРазделить(ВыбранныеФайлы[0], "\").Количество() - 1])
КонецПроцедуры

// Отправить файл
//
&НаСервере
Процедура ОтправитьФайлНаСервере(ДанынеФайла, ИмяФайла = "123.txt")
	Если Не ПустаяСтрока(ДанынеФайла) Тогда
		ИнтеграцияWhatsApp = ПолучитьОбработкуОбъект();
		ИнтеграцияWhatsApp.ОтправитьФайл(
			ТекущийИдентификаторЧата,
			ДанынеФайла,
			ИмяФайла,
			ИнтеграцияWhatsApp.СоздатьПараметрыСУ(
				ИдентификаторИнстаса,   
				Объект.ТипАутентификации,
				?(Объект.ТипАутентификации = "apiKey", Объект.КлючAPI, Объект.Токен),
				Объект.БазовыйURL,
				Объект.Порт,
				Объект.ИспользоватьSSL,
			),
			Сообщение
		);		
	КонецЕсли;
КонецПроцедуры



