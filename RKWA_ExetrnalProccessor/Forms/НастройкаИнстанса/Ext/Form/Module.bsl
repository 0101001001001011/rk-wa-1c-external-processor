КонецПроцедуры

// Отобразить QR
//
&НаКлиенте
Процедура ПолеQRДокументСформирован(Элемент)
	Если НЕ ПустаяСтрока(Идентификатор) Тогда
		СтрокаПередачи = Строка(QRКод);
		АктивноеОкноQR = ПолучитьАктивноеОкно();
		АктивноеОкноQR.displayQRCode(XMLСтрока(Статус), СтрокаПередачи);
	КонецЕсли;
КонецПроцедуры

// Получить Активное окно HTML
//
&НаКлиенте
Функция ПолучитьАктивноеОкно()
	Если ЗначениеЗаполнено(КэшированныеЭлементы) Тогда
		ОбъектWindow = КэшированныеЭлементы;	
	Иначе
		КэшированныеЭлементы = Элементы.ПолеQR.Документ.parentWindow;    // IE-only 
		Если КэшированныеЭлементы = Неопределено Тогда  
			КэшированныеЭлементы = Элементы.ПолеQR.Документ.defaultView; // Другие браузеры
		КонецЕсли;
		ОбъектWindow = КэшированныеЭлементы;
	КонецЕсли;
	Возврат ОбъектWindow;
КонецФункции

