            СообщениеСтруктура.Вставить("ИдентификаторСообщения", Выборка.ИдентификаторСообщения);
            СообщениеСтруктура.Вставить("Исходящее", Выборка.Исходящее);
            СообщениеСтруктура.Вставить("Время", Выборка.Время);
            СообщениеСтруктура.Вставить("ИнстансWhatsApp", Выборка.ИнстансWhatsApp);
            СообщениеСтруктура.Вставить("Статус", Выборка.Статус);
            СообщениеСтруктура.Вставить("ВремяОбновленияСтатуса", Выборка.ВремяОбновленияСтатуса);
            СообщениеСтруктура.Вставить("ЕстьФайл", Выборка.ЕстьФайл);
            
            Если Выборка.ЕстьФайл Тогда
                СообщениеСтруктура.Вставить("ИдентификаторФайла", Выборка.ИдентификаторФайла);
                СообщениеСтруктура.Вставить("ИмяФайла", Выборка.ИмяФайла);
                СообщениеСтруктура.Вставить("ТипФайла", Выборка.ТипФайла);
            КонецЕсли;
            
            Сообщения.Добавить(СообщениеСтруктура);
        КонецЦикла;
        
        Возврат Сообщения;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "НайтиСообщенияПоТексту: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Очистка истории переписки
//
// Параметры:
//   НомерТелефона - Строка - Номер телефона контакта
//   ИдИнстанса - Строка - Идентификатор инстанса WhatsApp (опционально)
//   ДатаНачала - Дата - Начальная дата для очистки (опционально)
//   ДатаОкончания - Дата - Конечная дата для очистки (опционально)
//
// Возвращаемое значение:
//   Булево - Результат операции
//
Функция ОчиститьИсториюПереписки(НомерТелефона, ИдИнстанса = "", 
                               ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(НомерТелефона) Тогда
            ВызватьИсключение "Не указан номер телефона";
        КонецЕсли;
        
        // Форматируем номер телефона
        НомерТелефона = ФорматироватьНомерТелефона(НомерТелефона);
        
        // Получаем историю переписки для удаления файлов
        Сообщения = ПолучитьИсториюПереписки(НомерТелефона, ИдИнстанса, ДатаНачала, ДатаОкончания);
        
        // Удаляем файлы сообщений
        Для Каждого Сообщение Из Сообщения Цикл
            Если Сообщение.ЕстьФайл И ЗначениеЗаполнено(Сообщение.ИдентификаторФайла) Тогда
                Попытка
                    УдалитьФайлИзХранилища(Сообщение.ИдентификаторФайла);
                Исключение
                    ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                        "Ошибка удаления файла сообщения: " + ОписаниеОшибки());
                КонецПопытки;
            КонецЕсли;
        КонецЦикла;
        
        // Формируем условие для удаления записей
        МенеджерРегистра = РегистрыСведений.СообщенияWhatsApp;
        НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
        
        Отбор = НаборЗаписей.Отбор;
        Отбор.НомерТелефона.Установить(НомерТелефона);
        
        Если Не ПустаяСтрока(ИдИнстанса) Тогда
            Отбор.ИнстансWhatsApp.Установить(ИдИнстанса);
        КонецЕсли;
        
        Если ДатаНачала <> Неопределено Тогда
            Отбор.Время.Установить(ДатаНачала, ВидСравнения.БольшеИлиРавно);
        КонецЕсли;
        
        Если ДатаОкончания <> Неопределено Тогда
            Отбор.Время.Установить(ДатаОкончания, ВидСравнения.МеньшеИлиРавно);
        КонецЕсли;
        
        // Удаляем записи
        НаборЗаписей.Прочитать();
        НаборЗаписей.Очистить();
        НаборЗаписей.Записать();
        
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Информация,,,
            "История переписки очищена для номера: " + НомерТелефона);
            
        Возврат Истина;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ОчиститьИсториюПереписки: " + ИнфоОшибки.Описание);
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

// Получение статистики сообщений
//
// Параметры:
//   ИдИнстанса - Строка - Идентификатор инстанса WhatsApp (опционально)
//   ДатаНачала - Дата - Начальная дата для статистики (опционально)
//   ДатаОкончания - Дата - Конечная дата для статистики (опционально)
//
// Возвращаемое значение:
//   Структура - Данные статистики или Неопределено при ошибке
//
Функция ПолучитьСтатистикуСообщений(ИдИнстанса = "", 
                                  ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт
    
    Попытка
        // Формируем запрос для получения статистики
        Запрос = Новый Запрос;
        ТекстЗапроса =
        "ВЫБРАТЬ
        |   СУММА(ВЫБОР
        |       КОГДА СообщенияWhatsApp.Исходящее = ИСТИНА
        |           ТОГДА 1
        |       ИНАЧЕ 0
        |   КОНЕЦ) КАК КоличествоИсходящих,
        |   СУММА(ВЫБОР
        |       КОГДА СообщенияWhatsApp.Исходящее = ЛОЖЬ
        |           ТОГДА 1
        |       ИНАЧЕ 0
        |   КОНЕЦ) КАК КоличествоВходящих,
        |   СУММА(ВЫБОР
        |       КОГДА СообщенияWhatsApp.ЕстьФайл = ИСТИНА И СообщенияWhatsApp.Исходящее = ИСТИНА
        |           ТОГДА 1
        |       ИНАЧЕ 0
        |   КОНЕЦ) КАК КоличествоИсходящихСФайлами,
        |   СУММА(ВЫБОР
        |       КОГДА СообщенияWhatsApp.ЕстьФайл = ИСТИНА И СообщенияWhatsApp.Исходящее = ЛОЖЬ
        |           ТОГДА 1
        |       ИНАЧЕ 0
        |   КОНЕЦ) КАК КоличествоВходящихСФайлами,
        |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СообщенияWhatsApp.НомерТелефона) КАК КоличествоКонтактов
        |ИЗ
        |   РегистрСведений.СообщенияWhatsApp КАК СообщенияWhatsApp
        |ГДЕ
        |   ИСТИНА";
        
        Если Не ПустаяСтрока(ИдИнстанса) Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.ИнстансWhatsApp = &ИнстансWhatsApp";
            Запрос.УстановитьПараметр("ИнстансWhatsApp", ИдИнстанса);
        КонецЕсли;
        
        Если ДатаНачала <> Неопределено Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.Время >= &ДатаНачала";
            Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
        КонецЕсли;
        
        Если ДатаОкончания <> Неопределено Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.Время <= &ДатаОкончания";
            Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
        КонецЕсли;
        
        Запрос.Текст = ТекстЗапроса;
        
        // Запрос для получения статистики по статусам
        ЗапросСтатусы = Новый Запрос;
        ТекстЗапросаСтатусы =
        "ВЫБРАТЬ
        |   СообщенияWhatsApp.Статус КАК Статус,
        |   КОЛИЧЕСТВО(1) КАК Количество
        |ИЗ
        |   РегистрСведений.СообщенияWhatsApp КАК СообщенияWhatsApp
        |ГДЕ
        |   СообщенияWhatsApp.Исходящее = ИСТИНА";
        
        Если Не ПустаяСтрока(ИдИнстанса) Тогда
            ТекстЗапросаСтатусы = ТекстЗапросаСтатусы + "
            |   И СообщенияWhatsApp.ИнстансWhatsApp = &ИнстансWhatsApp";
            ЗапросСтатусы.УстановитьПараметр("ИнстансWhatsApp", ИдИнстанса);
        КонецЕсли;
        
        Если ДатаНачала <> Неопределено Тогда
            ТекстЗапросаСтатусы = ТекстЗапросаСтатусы + "
            |   И СообщенияWhatsApp.Время >= &ДатаНачала";
            ЗапросСтатусы.УстановитьПараметр("ДатаНачала", ДатаНачала);
        КонецЕсли;
        
        Если ДатаОкончания <> Неопределено Тогда
            ТекстЗапросаСтатусы = ТекстЗапросаСтатусы + "
            |   И СообщенияWhatsApp.Время <= &ДатаОкончания";
            ЗапросСтатусы.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
        КонецЕсли;
        
        ТекстЗапросаСтатусы = ТекстЗапросаСтатусы + "
        |СГРУППИРОВАТЬ ПО
        |   СообщенияWhatsApp.Статус";
        
        ЗапросСтатусы.Текст = ТекстЗапросаСтатусы;
        
        // Выполняем запросы
        РезультатЗапроса = Запрос.Выполнить();
        РезультатЗапросаСтатусы = ЗапросСтатусы.Выполнить();
        
        // Формируем результат
        Выборка = РезультатЗапроса.Выбрать();
        Выборка.Следующий();
        
        ВыборкаСтатусы = РезультатЗапросаСтатусы.Выбрать();
        
        Статистика = Новый Структура;
        Статистика.Вставить("КоличествоИсходящих", Выборка.КоличествоИсходящих);
        Статистика.Вставить("КоличествоВходящих", Выборка.КоличествоВходящих);
        Статистика.Вставить("КоличествоИсходящихСФайлами", Выборка.КоличествоИсходящихСФайлами);
        Статистика.Вставить("КоличествоВходящихСФайлами", Выборка.КоличествоВходящихСФайлами);
        Статистика.Вставить("КоличествоКонтактов", Выборка.КоличествоКонтактов);
        Статистика.Вставить("ОбщееКоличество", Выборка.КоличествоИсходящих + Выборка.КоличествоВходящих);
        
        // Добавляем статистику по статусам
        СтатусыСтатистика = Новый Соответствие;
        
        Пока ВыборкаСтатусы.Следующий() Цикл
            СтатусыСтатистика.Вставить(ВыборкаСтатусы.Статус, ВыборкаСтатусы.Количество);
        КонецЦикла;
        
        Статистика.Вставить("Статусы", СтатусыСтатистика);
        
        Возврат Статистика;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьСтатистикуСообщений: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Архивация входящего файла
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные - Данные файла
//   ИмяФайла - Строка - Имя файла
//   ТипФайла - Строка - MIME-тип файла
//   ИдСообщения - Строка - Идентификатор сообщения
//
// Возвращаемое значение:
//   Строка - Путь к архиву или Неопределено при ошибке
//
Функция АрхивироватьФайл(ДвоичныеДанные, ИмяФайла, ТипФайла, ИдСообщения) Экспорт
    
    Попытка
        // Создаем временную директорию для файла
        ВременныйКаталог = ПолучитьИмяВременногоФайла();
        ВременныйКаталог = СтрЗаменить(ВременныйКаталог, ".tmp", "");
        СоздатьКаталог(ВременныйКаталог);
        
        // Сохраняем файл
        ПутьКФайлу = ВременныйКаталог + "\" + ИмяФайла;
        ДвоичныеДанные.Записать(ПутьКФайлу);
        
        // Создаем архив
        ИмяАрхива = ВременныйКаталог + ".zip";
        ЗаписьZIP = Новый ЗаписьZipФайла(ИмяАрхива);
        ЗаписьZIP.Добавить(ПутьКФайлу);
        ЗаписьZIP.Записать();
        
        // Удаляем временные файлы
        УдалитьФайлы(ВременныйКаталог);
        
        Возврат ИмяАрхива;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "АрхивироватьФайл: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Распаковка архива с файлом
//
// Параметры:
//   ПутьКАрхиву - Строка - Путь к архиву
//   ИмяФайла - Строка - Имя файла для поиска в архиве
//
// Возвращаемое значение:
