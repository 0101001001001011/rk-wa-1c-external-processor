// Подготовка multipart запроса для отправки файла
//
// Параметры:
//  ДанныеФайла - ДвоичныеДанные - Содержимое файла
//  ИмяФайла - Строка - Имя файла
//  Разделитель - Строка - Разделитель частей multipart
//
// Возвращаемое значение:
//   Строка - Подготовленный multipart запрос
//
Функция ПодготовитьMultipartЗапрос(ДанныеФайла, ИмяФайла, Разделитель) Экспорт
    
    Попытка
        ТекстЗапроса = Новый ТекстовыйДокумент;
        
        // Начало multipart
        ТекстЗапроса.ДобавитьСтроку("--" + Разделитель);
        ТекстЗапроса.ДобавитьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """");
        ТекстЗапроса.ДобавитьСтроку("Content-Type: application/octet-stream");
        ТекстЗапроса.ДобавитьСтроку("");
        
        // Добавляем данные файла в base64
        ТекстЗапроса.ДобавитьСтроку(Base64Строка(ДанныеФайла));
        
        // Закрываем multipart
        ТекстЗапроса.ДобавитьСтроку("--" + Разделитель + "--");
        
        Возврат ТекстЗапроса.ПолучитьТекст();
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПодготовитьMultipartЗапрос: " + ИнфоОшибки.Описание);
        Возврат "";
    КонецПопытки;
    
КонецФункции

// Форматирование номера телефона для API
//
// Параметры:
//  Номер - Строка - Номер телефона для форматирования
//
// Возвращаемое значение:
//   Строка - Отформатированный номер
//
Функция ФорматироватьНомерТелефона(Номер) Экспорт
    
    Попытка
        // Удаляем все нецифровые символы
        Номер = СтрЗаменить(Номер, "+", "");
        Номер = СтрЗаменить(Номер, "-", "");
        Номер = СтрЗаменить(Номер, " ", "");
        Номер = СтрЗаменить(Номер, "(", "");
        Номер = СтрЗаменить(Номер, ")", "");
        
        // Убираем суффикс @s.whatsapp.net или @c.us, если он есть
        Номер = СтрЗаменить(Номер, "@s.whatsapp.net", "");
        Номер = СтрЗаменить(Номер, "@c.us", "");
        
        Возврат Номер;
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ФорматироватьНомерТелефона: " + ИнфоОшибки.Описание);
        Возврат Номер;
    КонецПопытки;
    
КонецФункции

