            ОбновленныйИнстанс.Вставить("ИдПользователя", ДанныеОтвета.userId);
            ОбновленныйИнстанс.Вставить("Статус", ДанныеОтвета.status);
            
            Если ДанныеОтвета.Свойство("webhookUrl") Тогда
                ОбновленныйИнстанс.Вставить("АдресВебхука", ДанныеОтвета.webhookUrl);
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("webhookEnabled") Тогда
                ОбновленныйИнстанс.Вставить("ВебхукВключен", ДанныеОтвета.webhookEnabled);
            КонецЕсли;
            
            // Статистика сообщений
            Если ДанныеОтвета.Свойство("sentMessages") Тогда
                ОбновленныйИнстанс.Вставить("ОтправленоСообщений", ДанныеОтвета.sentMessages);
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("receivedMessages") Тогда
                ОбновленныйИнстанс.Вставить("ПолученоСообщений", ДанныеОтвета.receivedMessages);
            КонецЕсли;
            
            // Системные даты
            Если ДанныеОтвета.Свойство("lastActivity") И ЗначениеЗаполнено(ДанныеОтвета.lastActivity) Тогда
                ОбновленныйИнстанс.Вставить("ДатаПоследнейАктивности", XMLЗначение(Тип("Дата"), ДанныеОтвета.lastActivity));
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("createdAt") И ЗначениеЗаполнено(ДанныеОтвета.createdAt) Тогда
                ОбновленныйИнстанс.Вставить("ДатаСоздания", XMLЗначение(Тип("Дата"), ДанныеОтвета.createdAt));
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("updatedAt") И ЗначениеЗаполнено(ДанныеОтвета.updatedAt) Тогда
                ОбновленныйИнстанс.Вставить("ДатаОбновления", XMLЗначение(Тип("Дата"), ДанныеОтвета.updatedAt));
            КонецЕсли;
            
            Результат.Вставить("Инстанс", ОбновленныйИнстанс);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Инстанс успешно обновлен. ID: " + ДанныеОтвета.id);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка обновления инстанса");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка обновления инстанса");
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка обновления инстанса: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ОбновитьИнстансРусский: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

