//
Функция РаспаковатьФайлИзАрхива(ПутьКАрхиву, ИмяФайла) Экспорт
    
    Попытка
        // Создаем временную директорию для распаковки
        ВременныйКаталог = ПолучитьИмяВременногоФайла();
