        СоздатьКаталог(ВременныйКаталог);
        
        // Распаковываем архив
        ЧтениеZIP = Новый ЧтениеZipФайла(ПутьКАрхиву);
        ЧтениеZIP.ИзвлечьВсе(ВременныйКаталог);
        ЧтениеZIP.Закрыть();
        
        // Находим файл в распакованной директории
        ПутьКФайлу = ВременныйКаталог + "\" + ИмяФайла;
        
		//Если Не ФайлСуществует(ПутьКФайлу) Тогда
		//    // Если файл не найден, ищем его в поддиректориях
		//    НайденныеФайлы = НайтиФайлы(ВременныйКаталог, ИмяФайла, Истина);
		//    
		//    Если НайденныеФайлы.Количество() > 0 Тогда
		//        ПутьКФайлу = НайденныеФайлы[0].ПолноеИмя;
		//    Иначе
		//        ВызватьИсключение "Файл не найден в архиве: " + ИмяФайла;
		//    КонецЕсли;
		//КонецЕсли;
        
        // Загружаем файл
        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
        
        // Удаляем временные файлы
        УдалитьФайлы(ВременныйКаталог);
        
        Возврат ДвоичныеДанные;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
