            "invoice.pdf",
            "application/pdf",
            Истина,
            ТекущаяДата(),
            ИдИнстанса
        );
    КонецЕсли;
    
    Возврат (Результат1.Успех И Результат2.Успех И Результат3.Успех);
    
КонецФункции

