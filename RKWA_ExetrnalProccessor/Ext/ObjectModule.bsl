// Преобразовать массив контактов из API в массив структур с русскими названиями
//
// Параметры:
//  Контакты - Массив - Массив контактов, полученных из API
//
// Возвращаемое значение:
//   Массив - Массив структур с русскими названиями полей
//
Функция ПреобразоватьКонтакты(Контакты) Экспорт
    
    Попытка
        Если ТипЗнч(Контакты) <> Тип("Массив") Тогда
            ВызватьИсключение "Неверный тип данных. Ожидается массив.";
        КонецЕсли;
        
        РезультатМассив = Новый Массив;
        
        Для Каждого Контакт Из Контакты Цикл
            // Создаем структуру с русскими названиями полей
            КонтактСтруктура = Новый Структура;
            
            // Основные данные контакта
            КонтактСтруктура.Вставить("Идентификатор", Контакт.id);
            КонтактСтруктура.Вставить("Имя", Контакт.name);
            КонтактСтруктура.Вставить("Номер", Контакт.number);
            КонтактСтруктура.Вставить("ЭтоГруппа", Контакт.isGroup);
            
            // Добавляем преобразованную структуру в результирующий массив
            РезультатМассив.Добавить(КонтактСтруктура);
        КонецЦикла;
        
        Возврат РезультатМассив;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПреобразоватьКонтакты: " + ИнфоОшибки.Описание);
        Возврат Новый Массив;
    КонецПопытки;
    
КонецФункции

// Преобразовать массив инстансов из API в массив структур с русскими названиями
//
// Параметры:
//  Инстансы - Массив - Массив инстансов, полученных из API
//
// Возвращаемое значение:
//   Массив - Массив структур с русскими названиями полей
//
Функция ПреобразоватьИнстансы(Инстансы) Экспорт
    
    Попытка
        Если ТипЗнч(Инстансы) <> Тип("Массив") Тогда
            ВызватьИсключение "Неверный тип данных. Ожидается массив.";
        КонецЕсли;
        
        РезультатМассив = Новый Массив;
        
        Для Каждого Инстанс Из Инстансы Цикл
            // Создаем структуру с русскими названиями полей
            ИнстансСтруктура = Новый Структура;
            
            // Основные данные инстанса
            ИнстансСтруктура.Вставить("Идентификатор"		, Инстанс.id);
            ИнстансСтруктура.Вставить("Наименование"		, Инстанс.name);
            ИнстансСтруктура.Вставить("Описание"			, Инстанс.description);
            ИнстансСтруктура.Вставить("ИдПользователя"		, Инстанс.userId);
            ИнстансСтруктура.Вставить("Статус"				, Инстанс.status);
            ИнстансСтруктура.Вставить("QRКод"				, Инстанс.qrCode);
            
            // Данные вебхука
            ИнстансСтруктура.Вставить("АдресВебхука"		, Инстанс.webhookUrl);
            ИнстансСтруктура.Вставить("ВебхукВключен"		, Инстанс.webhookEnabled);
            
            // Статистика сообщений
            ИнстансСтруктура.Вставить("ОтправленоСообщений"	, Инстанс.sentMessages);
            ИнстансСтруктура.Вставить("ПолученоСообщений"	, Инстанс.receivedMessages);
			
			// Системные даты
            ИнстансСтруктура.Вставить("ДатаПоследнейАктивности"		, ?(НЕ ПустаяСтрока(Инстанс.lastActivity)	, XMLЗначение(Тип("Дата"), Инстанс.lastActivity), ТекущаяДата()));
            ИнстансСтруктура.Вставить("ДатаСоздания"				, ?(НЕ ПустаяСтрока(Инстанс.createdAt)		, XMLЗначение(Тип("Дата"), Инстанс.createdAt)	, ТекущаяДата()));
            ИнстансСтруктура.Вставить("ДатаОбновления"				, ?(НЕ ПустаяСтрока(Инстанс.updatedAt)		, XMLЗначение(Тип("Дата"), Инстанс.updatedAt)	, ТекущаяДата()));
            
            // Добавляем преобразованную структуру в результирующий массив
            РезультатМассив.Добавить(ИнстансСтруктура);
        КонецЦикла;
        
        Возврат РезультатМассив;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПреобразоватьИнстансы: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Сериализация в JSON
//
// Параметры:
//  Данные - Произвольный - Данные для сериализации
//
// Возвращаемое значение:
//   Строка - JSON представление данных
//
Функция ЗаписатьВJSON(Данные) Экспорт
    
    Попытка
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Данные);
        Возврат ЗаписьJSON.Закрыть();
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ЗаписатьВJSON: " + ИнфоОшибки.Описание);
        Возврат "";
    КонецПопытки;
    
КонецФункции

// Десериализация из JSON
//
// Параметры:
//  Данные - Строка - JSON строка для десериализации
//
// Возвращаемое значение:
//   Произвольный - Результат десериализации
//
Функция ПрочитатьИзJSON(Данные) Экспорт
    
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Данные);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПрочитатьИзJSON: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Сохранить общие настройки
//	Параметры:
//		КлючОбъект 		- Строка
//		КлючНастроек 	- Строка
//		Настройки		- Структура
//
Процедура СохранитьОбщиеНастройки(КлючОбъекта = "RKWA1C", КлючНстроек = "Authorization", Настройки) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНстроек, ЗаписатьВJSON(Настройки),,);
КонецПроцедуры

// Загрузить общие настройки
//	Параметры:
//		КлючОбъект 				- Строка
//		КлючНастроек 			- Строка
//	Возврат:
//		СохраненнаяНастройка 	- Строка
//
Функция ЗагрузитьОбщиеНастройки(КлючОбъекта = "RKWA1C", КлючНстроек = "Authorization") Экспорт
	УстановитьПривилегированныйРежим(Истина);
	СохраненныеНастройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНстроек,,);
	Если СохраненныеНастройки <> Неопределено Тогда
		СохраненныеНастройки = ПрочитатьИзJSON(СохраненныеНастройки);
	Иначе
		Если КлючНстроек = "Authorization" Тогда
			СохраненныеНастройки = Новый Структура(
			                        	"Пользователь,
										|Пароль,
										|Токен,
										|КлючAPI,
										|Авторизован,
										|БазовыйURL,
										|Порт,
										|ИспользоватьSSL,
										|ТипАутентификации",
										"admin@example.com",
										"admin123",
										"",
										"",
										Ложь,
										"localhost",
										7001,
										Ложь,
										"none"
									);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СохраненныеНастройки;
КонецФункции

#КонецОбласти

