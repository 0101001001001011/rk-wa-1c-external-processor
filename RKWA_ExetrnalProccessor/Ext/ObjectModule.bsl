            ДанныеИнстанса.Вставить("webhookEnabled", ИнстансСтруктура.ВебхукВключен);
        КонецЕсли;
        
        // Настройки вебхука
        Если ИнстансСтруктура.Свойство("НастройкиВебхука") И ТипЗнч(ИнстансСтруктура.НастройкиВебхука) = Тип("Структура") Тогда
            НастройкиВебхука = Новый Структура;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОПолучении") Тогда
                НастройкиВебхука.Вставить("notifyReceived", ИнстансСтруктура.НастройкиВебхука.УведомлятьОПолучении);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОбОтправке") Тогда
                НастройкиВебхука.Вставить("notifySent", ИнстансСтруктура.НастройкиВебхука.УведомлятьОбОтправке);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОДоставке") Тогда
                НастройкиВебхука.Вставить("notifyDelivery", ИнстансСтруктура.НастройкиВебхука.УведомлятьОДоставке);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОПрочтении") Тогда
                НастройкиВебхука.Вставить("notifyRead", ИнстансСтруктура.НастройкиВебхука.УведомлятьОПрочтении);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("МаксимальноеКоличествоПопыток") Тогда
                НастройкиВебхука.Вставить("maxRetries", ИнстансСтруктура.НастройкиВебхука.МаксимальноеКоличествоПопыток);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("ИнтервалПовтора") Тогда
                НастройкиВебхука.Вставить("retryInterval", ИнстансСтруктура.НастройкиВебхука.ИнтервалПовтора);
