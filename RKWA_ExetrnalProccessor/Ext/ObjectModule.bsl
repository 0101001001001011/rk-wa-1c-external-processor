//////////////////////////////////////////////////////
// Пример 9: Обработка входящего сообщения
//////////////////////////////////////////////////////

Процедура ПримерОбработчикаВходящегоСообщения(Данные, ПараметрыСУ)
    
    // Получаем информацию о сообщении
    НомерОтправителя = Данные.remoteJid;
    ТекстСообщения = Данные.body;
    ВремяОтправки = Данные.timestamp;
    ИдСообщения = Данные.messageId;
    
    ВывестиСообщение("Получено сообщение от " + НомерОтправителя + ": " + ТекстСообщения);
    
    // Сохраняем сообщение в базу данных
    СохранитьСообщение(
        НомерОтправителя,
        ТекстСообщения,
        ИдСообщения,
        Ложь, // Входящее сообщение
        ВремяОтправки,
        ПараметрыСУ.instanceId
    );
    
    // Распознаем команды (простой пример)
    Если НРег(ТекстСообщения) = "привет" Тогда
        // Отправляем приветственное сообщение
        ОтправитьСообщение(
            НомерОтправителя,
            "Здравствуйте! Чем могу помочь?",
            ПараметрыСУ
        );
    ИначеЕсли НРег(ТекстСообщения) = "справка" Тогда
        // Отправляем справочное сообщение
        ОтправитьСообщение(
            НомерОтправителя,
            "Доступные команды:" + Символы.ПС +
            "- привет - приветствие" + Символы.ПС +
            "- справка - список команд" + Символы.ПС +
            "- статус - проверка статуса системы",
            ПараметрыСУ
        );
    ИначеЕсли НРег(ТекстСообщения) = "статус" Тогда
        // Отправляем информацию о статусе системы
        ОтправитьСообщение(
            НомерОтправителя,
            "Статус системы: Активна" + Символы.ПС +
            "Время работы: 10 ч 25 мин" + Символы.ПС +
            "Обработано сообщений: 152",
            ПараметрыСУ
        );
    Иначе
        // Используем распознавание текста для интеллектуальной обработки
        ОбработатьТекстСообщения(НомерОтправителя, ТекстСообщения, ПараметрыСУ);
    КонецЕсли;
    
КонецПроцедуры

// Обработка текста сообщения с использованием простого анализа ключевых слов
// В реальной системе здесь может быть интеграция с NLP/AI сервисами
Процедура ОбработатьТекстСообщения(НомерОтправителя, ТекстСообщения, ПараметрыСУ)
    
    НижнийРегистр = НРег(ТекстСообщения);
    
    // Проверяем наличие ключевых слов в сообщении
    Если СтрНайти(НижнийРегистр, "заказ") > 0 Тогда
        // Обработка запроса о заказе
        ОтправитьСообщение(
            НомерОтправителя,
            "Для получения информации о заказе, пожалуйста, укажите номер заказа.",
            ПараметрыСУ
        );
    ИначеЕсли СтрНайти(НижнийРегистр, "оплат") > 0 Тогда
        // Обработка вопроса об оплате
        ОтправитьСообщение(
            НомерОтправителя,
            "Мы поддерживаем следующие способы оплаты: банковская карта, электронные деньги, наличные при получении.",
            ПараметрыСУ
        );
    ИначеЕсли СтрНайти(НижнийРегистр, "доставк") > 0 Тогда
        // Обработка вопроса о доставке
        ОтправитьСообщение(
            НомерОтправителя,
            "Срок доставки составляет от 1 до 3 рабочих дней в зависимости от вашего региона.",
            ПараметрыСУ
        );
    Иначе
        // Общий ответ для неизвестных запросов
        ОтправитьСообщение(
            НомерОтправителя,
            "Спасибо за ваше сообщение. Для получения консультации, пожалуйста, свяжитесь с нами по телефону 8-800-123-45-67.",
            ПараметрыСУ
        );
    КонецЕсли;
    
КонецПроцедуры

