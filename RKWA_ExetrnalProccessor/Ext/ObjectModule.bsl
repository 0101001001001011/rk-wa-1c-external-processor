//////////////////////////////////////////////////////
// Пример 1: Настройка и запуск интеграции
//////////////////////////////////////////////////////

// Создаем параметры подключения
Функция ПримерНастройкиИЗапуска()
    
    // Основные параметры подключения
    ИдИнстанса = "YOUR_INSTANCE_ID"; // Идентификатор вашего инстанса
    ТипАутентификации = "apiKey"; // или "token"
    КлючАутентификации = "YOUR_API_KEY"; // или токен
    СерверURL = "localhost"; // URL сервера WhatsApp API
    Порт = 3000; // Порт сервера
    
    // Создаем структуру параметров
    ПараметрыСУ = СоздатьПараметрыСУ(
        ИдИнстанса,
        ТипАутентификации,
        КлючАутентификации,
        СерверURL,
        Порт,
        Истина, // Использовать SSL
        5000,   // Интервал опроса в мс
        Ложь    // Авто-ответ
    );
    
    // Проверяем параметры соединения
    Если Не ПроверитьАутентификацию(ПараметрыСУ) Тогда
        ВывестиСообщение("Ошибка аутентификации. Проверьте параметры соединения.");
        Возврат Ложь;
    КонецЕсли;
    
    // Запускаем интеграцию
    Результат = ЗапуститьИнтеграцию(ПараметрыСУ);
    
    Если Результат Тогда
