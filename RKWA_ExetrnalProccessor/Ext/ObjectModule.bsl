            |   И СообщенияWhatsApp.ИнстансWhatsApp = &ИнстансWhatsApp";
            Запрос.УстановитьПараметр("ИнстансWhatsApp", ИдИнстанса);
        КонецЕсли;
        
        Если Не ПустаяСтрока(НомерТелефона) Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.НомерТелефона = &НомерТелефона";
