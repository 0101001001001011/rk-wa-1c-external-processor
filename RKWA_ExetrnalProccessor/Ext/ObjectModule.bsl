// Получение менеджера записи для сообщения
//
// Параметры:
//   ИдСообщения - Строка - Идентификатор сообщения
//
// Возвращаемое значение:
//   МенеджерЗаписиРегистраСведений, Неопределено - Менеджер записи или Неопределено при ошибке
//
Функция ПолучитьМенеджерЗаписиСообщения(ИдСообщения)
    
    Попытка
        // Создаем менеджер записи и устанавливаем отбор
        МенеджерЗаписи = РегистрыСведений.СообщенияWhatsApp.СоздатьМенеджерЗаписи();
        МенеджерЗаписи.ИдентификаторСообщения = ИдСообщения;
        МенеджерЗаписи.Прочитать();
        
        // Проверяем, что запись найдена
        Если МенеджерЗаписи.Выбран() Тогда
            Возврат МенеджерЗаписи;
        Иначе
            Возврат Неопределено;
        КонецЕсли;
    Исключение
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьМенеджерЗаписиСообщения: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Сохранение файла в хранилище файлов 1С
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные - Содержимое файла
//   ИмяФайла - Строка - Имя файла
//   ТипФайла - Строка - MIME-тип файла
//
// Возвращаемое значение:
//   Строка - Идентификатор файла в хранилище или Неопределено при ошибке
//
Функция СохранитьФайлВХранилище(ДвоичныеДанные, ИмяФайла, ТипФайла)
    
    Попытка
        // В данном примере мы сохраняем файл в хранилище с помощью метаданных 1С
        // В реальной системе здесь будет код для сохранения в хранилище файлов 1С
        
        // Префикс для идентификаторов файлов WhatsApp
        Префикс = "WA_";
        
        // Генерируем уникальный идентификатор для файла
        ИдентификаторФайла = Префикс + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
        
        // Сохраняем файл во временный каталог
        ВременныйФайл = ПолучитьИмяВременногоФайла();
        ДвоичныеДанные.Записать(ВременныйФайл);
        
        // В реальной системе здесь будет логика добавления файла в хранилище
        ХранилищеФайлов = ОбщегоНазначения.МенеджерХранилищаФайлов();
        АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
        
        // Сохраняем файл в хранилище (в реальной системе)
        ХранилищеФайлов.Записать(АдресВременногоХранилища, ИдентификаторФайла, ИмяФайла, ТипФайла);
        
        // Удаляем временный файл
        УдалитьФайлы(ВременныйФайл);
        
        Возврат ИдентификаторФайла;
        
    Исключение
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "СохранитьФайлВХранилище: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Получение двоичных данных файла из хранилища
//
// Параметры:
//   ИдентификаторФайла - Строка - Идентификатор файла
//
// Возвращаемое значение:
//   ДвоичныеДанные - Содержимое файла или Неопределено при ошибке
//
Функция ПолучитьДвоичныеДанныеИзХранилищаФайлов(ИдентификаторФайла)
    
    Попытка
        // В реальной системе здесь будет код для получения файла из хранилища файлов 1С
        
        // Получаем файл из хранилища
        ХранилищеФайлов = ОбщегоНазначения.МенеджерХранилищаФайлов();
        Результат = ХранилищеФайлов.Получить(ИдентификаторФайла);
        
        // Если файл не найден, возвращаем Неопределено
        Если Результат = Неопределено Тогда
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                "Файл не найден в хранилище: " + ИдентификаторФайла);
            Возврат Неопределено;
        КонецЕсли;
        
        // Возвращаем двоичные данные
        Возврат Результат.ДвоичныеДанные;
        
    Исключение
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьДвоичныеДанныеИзХранилищаФайлов: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

