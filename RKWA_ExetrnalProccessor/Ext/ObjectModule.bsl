// Проверка существования сообщения в хранилище
//
// Параметры:
//   ИдСообщения - Строка - Идентификатор сообщения для проверки
//
// Возвращаемое значение:
//   Булево - Признак существования сообщения
//
Функция СообщениеСуществует(ИдСообщения)
    
    // Проверяем наличие сообщения в хранилище
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ИСТИНА КАК ЕстьЗапись
    |ИЗ
    |   РегистрСведений.СообщенияWhatsApp КАК СообщенияWhatsApp
    |ГДЕ
    |   СообщенияWhatsApp.ИдентификаторСообщения = &ИдентификаторСообщения";
    
    Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдСообщения);
    
    РезультатЗапроса = Запрос.Выполнить();
    
    Возврат Не РезультатЗапроса.Пустой();
    
КонецФункции

// Создание структуры записи сообщения
//
// Параметры:
//   НомерТелефона - Строка - Номер телефона
//   ТекстСообщения - Строка - Текст сообщения
//   ИдСообщения - Строка - Идентификатор сообщения
//   Исходящее - Булево - Признак исходящего сообщения
//   ВремяСообщения - Дата - Время сообщения
//   ИдИнстанса - Строка - Идентификатор инстанса
//   ДополнительныеДанные - Структура - Дополнительные данные
//
// Возвращаемое значение:
//   Структура - Структура записи сообщения
//
Функция СоздатьЗаписьСообщения(НомерТелефона, ТекстСообщения, ИдСообщения, Исходящее, 
                             ВремяСообщения, ИдИнстанса, ДополнительныеДанные)
    
    ЗаписьСообщения = Новый Структура;
    ЗаписьСообщения.Вставить("НомерТелефона", НомерТелефона);
    ЗаписьСообщения.Вставить("Текст", ТекстСообщения);
    ЗаписьСообщения.Вставить("ИдентификаторСообщения", ИдСообщения);
    ЗаписьСообщения.Вставить("Исходящее", Исходящее);
    ЗаписьСообщения.Вставить("Время", ВремяСообщения);
    ЗаписьСообщения.Вставить("ИнстансWhatsApp", ИдИнстанса);
    ЗаписьСообщения.Вставить("Статус", ?(Исходящее, "sent", "received"));
    ЗаписьСообщения.Вставить("ВремяОбновленияСтатуса", ВремяСообщения);
    ЗаписьСообщения.Вставить("ЕстьФайл", Ложь);
    
    // Добавляем дополнительные данные, если они есть
    Если ДополнительныеДанные <> Неопределено Тогда
        ЗаписьСообщения.Вставить("ДополнительныеДанные", ДополнительныеДанные);
    КонецЕсли;
    
    Возврат ЗаписьСообщения;
    
КонецФункции

// Сохранение исходящего сообщения в хранилище
//
// Параметры:
//   ЗаписьСообщения - Структура - Данные сообщения для сохранения
//
// Возвращаемое значение:
//   Булево - Результат операции
//
Функция СохранитьИсходящееСообщение(ЗаписьСообщения)
    
    // Сохраняем сообщение в регистр сведений
    МенеджерЗаписи = РегистрыСведений.СообщенияWhatsApp.СоздатьМенеджерЗаписи();
    
    МенеджерЗаписи.ИдентификаторСообщения = ЗаписьСообщения.ИдентификаторСообщения;
    МенеджерЗаписи.НомерТелефона = ЗаписьСообщения.НомерТелефона;
    МенеджерЗаписи.Текст = ЗаписьСообщения.Текст;
    МенеджерЗаписи.Исходящее = Истина;
    МенеджерЗаписи.Время = ЗаписьСообщения.Время;
    МенеджерЗаписи.ИнстансWhatsApp = ЗаписьСообщения.ИнстансWhatsApp;
    МенеджерЗаписи.Статус = ЗаписьСообщения.Статус;
    МенеджерЗаписи.ВремяОбновленияСтатуса = ЗаписьСообщения.ВремяОбновленияСтатуса;
    
    // Добавляем информацию о файле, если есть
    Если ЗаписьСообщения.ЕстьФайл Тогда
        МенеджерЗаписи.ЕстьФайл = Истина;
        МенеджерЗаписи.ИдентификаторФайла = ЗаписьСообщения.ИдентификаторФайла;
        МенеджерЗаписи.ИмяФайла = ЗаписьСообщения.ИмяФайла;
        МенеджерЗаписи.ТипФайла = ЗаписьСообщения.ТипФайла;
    Иначе
        МенеджерЗаписи.ЕстьФайл = Ложь;
    КонецЕсли;
    
    // Добавляем дополнительные данные, если есть
    Если ЗаписьСообщения.Свойство("ДополнительныеДанные") И ЗаписьСообщения.ДополнительныеДанные <> Неопределено Тогда
        МенеджерЗаписи.ДополнительныеДанные = ЗаписьСообщения.ДополнительныеДанные;
    КонецЕсли;
    
    МенеджерЗаписи.Записать();
    
    ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Информация,,,
        "Сохранено исходящее сообщение: " + ЗаписьСообщения.ИдентификаторСообщения);
        
    Возврат Истина;
    
КонецФункции

