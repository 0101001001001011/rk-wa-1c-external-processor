// Создание параметров системы управления
//
// Параметры:
//   ИдИнстанса - Строка - Идентификатор инстанса WhatsApp
//   ТипАутентификации - Строка - Тип аутентификации ("apiKey" или "token")
//   КлючАутентификации - Строка - API ключ или токен для аутентификации
//   СерверURL - Строка - URL сервера WhatsApp API
//   Порт - Число - Порт сервера (по умолчанию 3000)
//   ИспользоватьSSL - Булево - Флаг использования SSL (по умолчанию Истина)
//   ИнтервалОпроса - Число - Интервал опроса сервера в миллисекундах (по умолчанию 5000)
//   АвтоОтвет - Булево - Флаг автоматического ответа на сообщения (по умолчанию Ложь)
//
// Возвращаемое значение:
//   Структура - Параметры системы управления
//
Функция СоздатьПараметрыСУ(ИдИнстанса, ТипАутентификации, КлючАутентификации, СерверURL, 
    Порт = 3000, ИспользоватьSSL = Истина, ИнтервалОпроса = 5000, АвтоОтвет = Ложь) Экспорт
    
    ПараметрыСУ = Новый Структура;
    
    // Основные параметры
    ПараметрыСУ.Вставить("instanceId"	, ИдИнстанса);
    ПараметрыСУ.Вставить("baseurl"		, СерверURL);
    ПараметрыСУ.Вставить("port"			, Порт);
    ПараметрыСУ.Вставить("useSSL"		, ИспользоватьSSL);
    
    // Параметры аутентификации
    ПараметрыСУ.Вставить("authType"		, ТипАутентификации);
    
    Если ТипАутентификации = "apiKey" Тогда
        ПараметрыСУ.Вставить("apiKey"	, КлючАутентификации);
    ИначеЕсли ТипАутентификации = "token" Тогда
        ПараметрыСУ.Вставить("token"	, КлючАутентификации);
	Иначе
		ПараметрыСУ.Вставить("authType"	, "token");
        ПараметрыСУ.Вставить("token"	, КлючАутентификации);
    КонецЕсли;
    
    // Параметры опроса
    ПараметрыСУ.Вставить("pollingInterval"		, ИнтервалОпроса);
    ПараметрыСУ.Вставить("lastEventTimestamp"	, "");
    
    // Дополнительные настройки
    ПараметрыСУ.Вставить("autoReply", АвтоОтвет);
    
    Возврат ПараметрыСУ;
    
КонецФункции

// Создать параметры системы управления с авторизацией
//
// Параметры:
//  ИдИнстанса - Строка - Идентификатор инстанса WhatsApp (опционально)
//  НастройкиАвторизации - Структура - Настройки авторизации (опционально, если не указаны, будут загружены из хранилища)
//  ПредпочтительныйТипАвторизации - Строка - Тип авторизации ("token" или "apiKey" или "basic") (опционально)
//
// Возвращаемое значение:
//   Структура - Параметры системы управления с настройками авторизации
//
Функция СоздатьАвторизованныеПараметрыСУ(ИдИнстанса = "", НастройкиАвторизации = Неопределено, ПредпочтительныйТипАвторизации = "token") Экспорт
    
    Попытка
        // Если настройки не переданы, загружаем из хранилища
        Если НастройкиАвторизации = Неопределено Тогда
            НастройкиАвторизации = ЗагрузитьОбщиеНастройки();
        КонецЕсли;
        
        // Проверяем авторизацию
        Если НЕ НастройкиАвторизации.Авторизован Тогда
            ВызватьИсключение "Пользователь не авторизован. Выполните авторизацию.";
        КонецЕсли;
        
        // Создаем параметры
        ПараметрыСУ = Новый Структура;
        ПараметрыСУ.Вставить("baseurl", НастройкиАвторизации.БазовыйURL);
        ПараметрыСУ.Вставить("port", НастройкиАвторизации.Порт);
        ПараметрыСУ.Вставить("useSSL", НастройкиАвторизации.ИспользоватьSSL);
        
        // Указываем идентификатор инстанса, если он передан
        Если ЗначениеЗаполнено(ИдИнстанса) Тогда
            ПараметрыСУ.Вставить("instanceId", ИдИнстанса);
        КонецЕсли;
        
        // Определяем тип авторизации
        Если ПредпочтительныйТипАвторизации = "token" И ЗначениеЗаполнено(НастройкиАвторизации.Токен) Тогда
            ПараметрыСУ.Вставить("authType", "token");
            ПараметрыСУ.Вставить("token", НастройкиАвторизации.Токен);
        ИначеЕсли ПредпочтительныйТипАвторизации = "apiKey" И ЗначениеЗаполнено(НастройкиАвторизации.КлючAPI) Тогда
            ПараметрыСУ.Вставить("authType", "apiKey");
            ПараметрыСУ.Вставить("apiKey", НастройкиАвторизации.КлючAPI);
        ИначеЕсли ПредпочтительныйТипАвторизации = "basic" И ЗначениеЗаполнено(НастройкиАвторизации.Пользователь) И ЗначениеЗаполнено(НастройкиАвторизации.Пароль) Тогда
            ПараметрыСУ.Вставить("authType", "basic");
            ПараметрыСУ.Вставить("login", НастройкиАвторизации.Пользователь);
            ПараметрыСУ.Вставить("password", НастройкиАвторизации.Пароль);
        // Если предпочтительный тип не доступен, используем любой доступный
        ИначеЕсли ЗначениеЗаполнено(НастройкиАвторизации.Токен) Тогда
            ПараметрыСУ.Вставить("authType", "token");
            ПараметрыСУ.Вставить("token", НастройкиАвторизации.Токен);
        ИначеЕсли ЗначениеЗаполнено(НастройкиАвторизации.КлючAPI) Тогда
            ПараметрыСУ.Вставить("authType", "apiKey");
            ПараметрыСУ.Вставить("apiKey", НастройкиАвторизации.КлючAPI);
        ИначеЕсли ЗначениеЗаполнено(НастройкиАвторизации.Пользователь) И ЗначениеЗаполнено(НастройкиАвторизации.Пароль) Тогда
            ПараметрыСУ.Вставить("authType", "basic");
            ПараметрыСУ.Вставить("login", НастройкиАвторизации.Пользователь);
            ПараметрыСУ.Вставить("password", НастройкиАвторизации.Пароль);
        Иначе
            ВызватьИсключение "Не найдены данные для авторизации";
        КонецЕсли;
        
        Возврат ПараметрыСУ;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "СоздатьАвторизованныеПараметрыСУ: " + ИнфоОшибки.Описание);
        ВызватьИсключение ИнфоОшибки.Описание;
    КонецПопытки;
    
КонецФункции

// Создать новый инстанс WhatsApp с русскими названиями полей
//
// Параметры:
//   ПараметрыСУ - Структура - Параметры системы управления
//   ИнстансСтруктура - Структура - Данные для создания инстанса с русскими названиями полей
//
// Возвращаемое значение:
//   Структура - Результат операции:
//    * Успех - Булево - Признак успешного создания
//    * Инстанс - Структура - Данные созданного инстанса (если успешно)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном создании)
//    * КодСостояния - Число - HTTP код состояния
//
Функция СоздатьИнстанс(ПараметрыСУ, ИнстансСтруктура) Экспорт
    
    Попытка
        Если НЕ ИнстансСтруктура.Свойство("Наименование") ИЛИ ПустаяСтрока(ИнстансСтруктура.Наименование) Тогда
            ВызватьИсключение "Не указано наименование инстанса";
        КонецЕсли;
        
        // Преобразуем инстанс из структуры с русскими названиями в формат API
        ДанныеИнстанса = Новый Структура;
        ДанныеИнстанса.Вставить("name", ИнстансСтруктура.Наименование);
        
        // Добавляем описание, если оно указано
        Если ИнстансСтруктура.Свойство("Описание") И ЗначениеЗаполнено(ИнстансСтруктура.Описание) Тогда
            ДанныеИнстанса.Вставить("description", ИнстансСтруктура.Описание);
        Иначе
            ДанныеИнстанса.Вставить("description", "");
        КонецЕсли;
        
        // Добавляем URL вебхука, если он указан
        Если ИнстансСтруктура.Свойство("АдресВебхука") И ЗначениеЗаполнено(ИнстансСтруктура.АдресВебхука) Тогда
            ДанныеИнстанса.Вставить("webhookUrl", ИнстансСтруктура.АдресВебхука);
        КонецЕсли;
        
        // Добавляем флаг включения вебхука, если он указан
        Если ИнстансСтруктура.Свойство("ВебхукВключен") Тогда
            ДанныеИнстанса.Вставить("webhookEnabled", ИнстансСтруктура.ВебхукВключен);
        КонецЕсли;
        
        // Настройки вебхука
        Если ИнстансСтруктура.Свойство("НастройкиВебхука") И ТипЗнч(ИнстансСтруктура.НастройкиВебхука) = Тип("Структура") Тогда
            НастройкиВебхука = Новый Структура;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОПолучении") Тогда
                НастройкиВебхука.Вставить("notifyReceived", ИнстансСтруктура.НастройкиВебхука.УведомлятьОПолучении);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОбОтправке") Тогда
                НастройкиВебхука.Вставить("notifySent", ИнстансСтруктура.НастройкиВебхука.УведомлятьОбОтправке);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОДоставке") Тогда
                НастройкиВебхука.Вставить("notifyDelivery", ИнстансСтруктура.НастройкиВебхука.УведомлятьОДоставке);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("УведомлятьОПрочтении") Тогда
                НастройкиВебхука.Вставить("notifyRead", ИнстансСтруктура.НастройкиВебхука.УведомлятьОПрочтении);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("МаксимальноеКоличествоПопыток") Тогда
                НастройкиВебхука.Вставить("maxRetries", ИнстансСтруктура.НастройкиВебхука.МаксимальноеКоличествоПопыток);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("ИнтервалПовтора") Тогда
                НастройкиВебхука.Вставить("retryInterval", ИнстансСтруктура.НастройкиВебхука.ИнтервалПовтора);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("СекретныйКлюч") Тогда
                НастройкиВебхука.Вставить("secret", ИнстансСтруктура.НастройкиВебхука.СекретныйКлюч);
            КонецЕсли;
            
            Если ИнстансСтруктура.НастройкиВебхука.Свойство("Заголовки") Тогда
                НастройкиВебхука.Вставить("headers", ИнстансСтруктура.НастройкиВебхука.Заголовки);
            КонецЕсли;
            
            ДанныеИнстанса.Вставить("webhookSettings", НастройкиВебхука);
        КонецЕсли;
        
        // Отправляем запрос на создание инстанса
        Ответ = ВыполнитьЗапросREST(
            "/api/instances",
            ПараметрыСУ,
            "POST",
            ДанныеИнстанса
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            // Обновляем идентификатор инстанса в параметрах
            ПараметрыСУ.instanceId = ДанныеОтвета.id;
            
            // Преобразуем полученный инстанс в структуру с русскими именами
            СозданныйИнстанс = Новый Структура;
            СозданныйИнстанс.Вставить("Идентификатор", ДанныеОтвета.id);
            СозданныйИнстанс.Вставить("Наименование", ДанныеОтвета.name);
            СозданныйИнстанс.Вставить("Описание", ДанныеОтвета.description);
            СозданныйИнстанс.Вставить("ИдПользователя", ДанныеОтвета.userId);
            СозданныйИнстанс.Вставить("Статус", ДанныеОтвета.status);
            
            Если ДанныеОтвета.Свойство("webhookUrl") Тогда
                СозданныйИнстанс.Вставить("АдресВебхука", ДанныеОтвета.webhookUrl);
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("webhookEnabled") Тогда
                СозданныйИнстанс.Вставить("ВебхукВключен", ДанныеОтвета.webhookEnabled);
            КонецЕсли;
            
            // Системные даты
            Если ДанныеОтвета.Свойство("lastActivity") И ЗначениеЗаполнено(ДанныеОтвета.lastActivity) Тогда
                СозданныйИнстанс.Вставить("ДатаПоследнейАктивности", XMLЗначение(Тип("Дата"), ДанныеОтвета.lastActivity));
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("createdAt") И ЗначениеЗаполнено(ДанныеОтвета.createdAt) Тогда
                СозданныйИнстанс.Вставить("ДатаСоздания", XMLЗначение(Тип("Дата"), ДанныеОтвета.createdAt));
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("updatedAt") И ЗначениеЗаполнено(ДанныеОтвета.updatedAt) Тогда
                СозданныйИнстанс.Вставить("ДатаОбновления", XMLЗначение(Тип("Дата"), ДанныеОтвета.updatedAt));
            КонецЕсли;
            
            Результат.Вставить("Инстанс", СозданныйИнстанс);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Инстанс успешно создан. ID: " + ДанныеОтвета.id);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка создания инстанса");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка создания инстанса");
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка создания инстанса: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "СоздатьИнстансРусский: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Обновить существующий инстанс WhatsApp с русскими названиями полей
//
// Параметры:
//   ПараметрыСУ - Структура - Параметры системы управления
//   ИнстансСтруктура - Структура - Данные для обновления инстанса с русскими названиями полей
//   ИдИнстанса - Строка - Идентификатор инстанса (если не указан, используется из ПараметрыСУ)
//
// Возвращаемое значение:
//   Структура - Результат операции:
//    * Успех - Булево - Признак успешного обновления
//    * Инстанс - Структура - Данные обновленного инстанса (если успешно)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном обновлении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция ОбновитьИнстанс(ПараметрыСУ, ИнстансСтруктура, ИдИнстанса = "") Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ИдИнстанса) Тогда
            // Если ИдИнстанса не указан, проверяем/используем из ПараметрыСУ
            Если ПустаяСтрока(ПараметрыСУ.instanceId) Тогда
                // Если и в ПараметрыСУ нет ID, проверяем наличие в структуре инстанса
                Если ИнстансСтруктура.Свойство("Идентификатор") И ЗначениеЗаполнено(ИнстансСтруктура.Идентификатор) Тогда
                    ИдИнстанса = ИнстансСтруктура.Идентификатор;
                Иначе
                    ВызватьИсключение "Не указан идентификатор инстанса";
                КонецЕсли;
            Иначе
                ИдИнстанса = ПараметрыСУ.instanceId;
            КонецЕсли;
        КонецЕсли;
        
        Если ИнстансСтруктура = Неопределено Тогда
            ВызватьИсключение "Не указаны данные инстанса";
        КонецЕсли;
        
        // Преобразуем инстанс из структуры с русскими названиями в формат API
        ДанныеИнстанса = Новый Структура;
        
        // Добавляем наименование, если оно указано
        Если ИнстансСтруктура.Свойство("Наименование") И ЗначениеЗаполнено(ИнстансСтруктура.Наименование) Тогда
            ДанныеИнстанса.Вставить("name", ИнстансСтруктура.Наименование);
        КонецЕсли;
        
        // Добавляем описание, если оно указано
        Если ИнстансСтруктура.Свойство("Описание") Тогда
            ДанныеИнстанса.Вставить("description", ИнстансСтруктура.Описание);
