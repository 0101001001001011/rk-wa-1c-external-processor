#Область ПрограммныйИнтерфейс

// Сохранение сообщения в хранилище 1С
//
// Параметры:
//   НомерТелефона - Строка - Номер телефона отправителя/получателя
//   ТекстСообщения - Строка - Текст сообщения
//   ИдСообщения - Строка - Уникальный идентификатор сообщения
//   Исходящее - Булево - Признак исходящего сообщения
//   ВремяСообщения - Дата - Время отправки/получения сообщения
//   ИдИнстанса - Строка - Идентификатор инстанса WhatsApp
//   ДополнительныеДанные - Структура - Дополнительные данные сообщения (опционально)
//
// Возвращаемое значение:
//   Булево - Результат сохранения сообщения
//
Функция СохранитьСообщение(НомерТелефона, ТекстСообщения, ИдСообщения, Исходящее, 
                          ВремяСообщения = Неопределено, ИдИнстанса = "", 
                          ДополнительныеДанные = Неопределено) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(НомерТелефона) Тогда
            ВызватьИсключение "Не указан номер телефона";
        КонецЕсли;
        
        Если ПустаяСтрока(ИдСообщения) Тогда
            ВызватьИсключение "Не указан идентификатор сообщения";
        КонецЕсли;
        
        // Если время не указано, используем текущее время
        Если ВремяСообщения = Неопределено Тогда
            ВремяСообщения = ТекущаяДата();
        КонецЕсли;
        
        // Подготовка номера телефона
        НомерТелефона = ФорматироватьНомерТелефона(НомерТелефона);
        
        // Проверка существования сообщения
        Если СообщениеСуществует(ИдСообщения) Тогда
            // Если сообщение уже существует, обновляем его статус
            Возврат ОбновитьСтатусСообщения(ИдСообщения, "received");
        КонецЕсли;
        
        // Формируем структуру для записи
        ЗаписьСообщения = СоздатьЗаписьСообщения(
            НомерТелефона,
            ТекстСообщения,
            ИдСообщения,
            Исходящее,
            ВремяСообщения,
            ИдИнстанса,
            ДополнительныеДанные
        );
        
        // Сохраняем сообщение в хранилище
        Если Исходящее Тогда
            Возврат СохранитьИсходящееСообщение(ЗаписьСообщения);
        Иначе
            Возврат СохранитьВходящееСообщение(ЗаписьСообщения);
        КонецЕсли;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "СохранитьСообщение: " + ИнфоОшибки.Описание);
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

// Сохранение сообщения с файлом в хранилище 1С
//
// Параметры:
//   НомерТелефона - Строка - Номер телефона отправителя/получателя
//   ТекстСообщения - Строка - Текст сообщения/подпись к файлу
//   ИдСообщения - Строка - Уникальный идентификатор сообщения
//   ДвоичныеДанныеФайла - ДвоичныеДанные - Содержимое файла
//   ИмяФайла - Строка - Имя файла
//   ТипФайла - Строка - Тип файла (MIME-тип)
//   Исходящее - Булево - Признак исходящего сообщения
//   ВремяСообщения - Дата - Время отправки/получения сообщения
//   ИдИнстанса - Строка - Идентификатор инстанса WhatsApp
//   ДополнительныеДанные - Структура - Дополнительные данные сообщения (опционально)
//
// Возвращаемое значение:
//   Булево - Результат сохранения сообщения
//
Функция СохранитьСообщениеСФайлом(НомерТелефона, ТекстСообщения, ИдСообщения, ДвоичныеДанныеФайла, 
                                ИмяФайла, ТипФайла, Исходящее, ВремяСообщения = Неопределено, 
                                ИдИнстанса = "", ДополнительныеДанные = Неопределено) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(НомерТелефона) Тогда
            ВызватьИсключение "Не указан номер телефона";
        КонецЕсли;
        
        Если ПустаяСтрока(ИдСообщения) Тогда
            ВызватьИсключение "Не указан идентификатор сообщения";
        КонецЕсли;
        
        Если ДвоичныеДанныеФайла = Неопределено Тогда
            ВызватьИсключение "Не указаны данные файла";
        КонецЕсли;
        
        // Если время не указано, используем текущее время
        Если ВремяСообщения = Неопределено Тогда
            ВремяСообщения = ТекущаяДата();
        КонецЕсли;
        
        // Подготовка номера телефона
        НомерТелефона = ФорматироватьНомерТелефона(НомерТелефона);
        
        // Проверка существования сообщения
        Если СообщениеСуществует(ИдСообщения) Тогда
            // Если сообщение уже существует, обновляем его статус
            Возврат ОбновитьСтатусСообщения(ИдСообщения, "received");
        КонецЕсли;
        
        // Сохраняем файл в хранилище файлов 1С
        Попытка
            ИдентификаторФайла = СохранитьФайлВХранилище(ДвоичныеДанныеФайла, ИмяФайла, ТипФайла);
        Исключение
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
                "Ошибка сохранения файла: " + ОписаниеОшибки());
            Возврат Ложь;
        КонецПопытки;
        
        // Формируем структуру для записи
        ЗаписьСообщения = СоздатьЗаписьСообщения(
            НомерТелефона,
            ТекстСообщения,
            ИдСообщения,
            Исходящее,
            ВремяСообщения,
            ИдИнстанса,
            ДополнительныеДанные
        );
        
        // Добавляем информацию о файле
        ЗаписьСообщения.ЕстьФайл = Истина;
        ЗаписьСообщения.ИдентификаторФайла = ИдентификаторФайла;
        ЗаписьСообщения.ИмяФайла = ИмяФайла;
        ЗаписьСообщения.ТипФайла = ТипФайла;
        
        // Сохраняем сообщение в хранилище
        Если Исходящее Тогда
            Возврат СохранитьИсходящееСообщение(ЗаписьСообщения);
        Иначе
            Возврат СохранитьВходящееСообщение(ЗаписьСообщения);
        КонецЕсли;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "СохранитьСообщениеСФайлом: " + ИнфоОшибки.Описание);
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

// Обновление статуса сообщения в хранилище 1С
//
// Параметры:
//   ИдСообщения - Строка - Уникальный идентификатор сообщения
//   Статус - Строка - Новый статус сообщения
//   ВремяОбновления - Дата - Время обновления статуса (по умолчанию текущее время)
//
// Возвращаемое значение:
//   Булево - Результат обновления статуса
//
Функция ОбновитьСтатусСообщения(ИдСообщения, Статус, ВремяОбновления = Неопределено) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ИдСообщения) Тогда
            ВызватьИсключение "Не указан идентификатор сообщения";
        КонецЕсли;
        
        Если ПустаяСтрока(Статус) Тогда
            ВызватьИсключение "Не указан статус сообщения";
        КонецЕсли;
        
        // Если время не указано, используем текущее время
        Если ВремяОбновления = Неопределено Тогда
            ВремяОбновления = ТекущаяДата();
        КонецЕсли;
        
        // Проверяем существование сообщения
        Если Не СообщениеСуществует(ИдСообщения) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                "Не найдено сообщение для обновления статуса: " + ИдСообщения);
            Возврат Ложь;
        КонецЕсли;
        
        // Получаем менеджер записи
        МенеджерЗаписи = ПолучитьМенеджерЗаписиСообщения(ИдСообщения);
        Если МенеджерЗаписи = Неопределено Тогда
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
                "Не удалось получить менеджер записи для сообщения: " + ИдСообщения);
            Возврат Ложь;
        КонецЕсли;
        
        // Обновляем статус
        МенеджерЗаписи.Статус = Статус;
        МенеджерЗаписи.ВремяОбновленияСтатуса = ВремяОбновления;
        МенеджерЗаписи.Записать();
        
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Информация,,,
            "Обновлен статус сообщения " + ИдСообщения + " на " + Статус);
            
        Возврат Истина;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ОбновитьСтатусСообщения: " + ИнфоОшибки.Описание);
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

// Получение сообщения по ID
//
// Параметры:
//   ИдСообщения - Строка - Уникальный идентификатор сообщения
//
// Возвращаемое значение:
//   Структура - Данные сообщения или Неопределено, если сообщение не найдено
//
Функция ПолучитьСообщение(ИдСообщения) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ИдСообщения) Тогда
            ВызватьИсключение "Не указан идентификатор сообщения";
        КонецЕсли;
        
        // Проверяем существование сообщения
        Если Не СообщениеСуществует(ИдСообщения) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                "Сообщение не найдено: " + ИдСообщения);
            Возврат Неопределено;
        КонецЕсли;
        
        // Получаем запись сообщения
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   СообщенияWhatsApp.НомерТелефона,
        |   СообщенияWhatsApp.Текст,
        |   СообщенияWhatsApp.ИдентификаторСообщения,
        |   СообщенияWhatsApp.Исходящее,
        |   СообщенияWhatsApp.Время,
        |   СообщенияWhatsApp.ИнстансWhatsApp,
        |   СообщенияWhatsApp.Статус,
        |   СообщенияWhatsApp.ВремяОбновленияСтатуса,
        |   СообщенияWhatsApp.ЕстьФайл,
        |   СообщенияWhatsApp.ИдентификаторФайла,
        |   СообщенияWhatsApp.ИмяФайла,
        |   СообщенияWhatsApp.ТипФайла,
        |   СообщенияWhatsApp.ДополнительныеДанные
        |ИЗ
        |   РегистрСведений.СообщенияWhatsApp КАК СообщенияWhatsApp
        |ГДЕ
        |   СообщенияWhatsApp.ИдентификаторСообщения = &ИдентификаторСообщения";
        
        Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдСообщения);
        
        РезультатЗапроса = Запрос.Выполнить();
        
        Если РезультатЗапроса.Пустой() Тогда
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                "Сообщение не найдено при запросе: " + ИдСообщения);
            Возврат Неопределено;
        КонецЕсли;
        
        // Формируем результат
        Выборка = РезультатЗапроса.Выбрать();
        Выборка.Следующий();
        
        РезультатСообщение = Новый Структура;
        РезультатСообщение.Вставить("НомерТелефона", Выборка.НомерТелефона);
        РезультатСообщение.Вставить("Текст", Выборка.Текст);
        РезультатСообщение.Вставить("ИдентификаторСообщения", Выборка.ИдентификаторСообщения);
        РезультатСообщение.Вставить("Исходящее", Выборка.Исходящее);
        РезультатСообщение.Вставить("Время", Выборка.Время);
        РезультатСообщение.Вставить("ИнстансWhatsApp", Выборка.ИнстансWhatsApp);
        РезультатСообщение.Вставить("Статус", Выборка.Статус);
        РезультатСообщение.Вставить("ВремяОбновленияСтатуса", Выборка.ВремяОбновленияСтатуса);
        РезультатСообщение.Вставить("ЕстьФайл", Выборка.ЕстьФайл);
        
        Если Выборка.ЕстьФайл Тогда
            РезультатСообщение.Вставить("ИдентификаторФайла", Выборка.ИдентификаторФайла);
            РезультатСообщение.Вставить("ИмяФайла", Выборка.ИмяФайла);
            РезультатСообщение.Вставить("ТипФайла", Выборка.ТипФайла);
        КонецЕсли;
        
        Если ЗначениеЗаполнено(Выборка.ДополнительныеДанные) Тогда
            РезультатСообщение.Вставить("ДополнительныеДанные", Выборка.ДополнительныеДанные);
        КонецЕсли;
        
        Возврат РезультатСообщение;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьСообщение: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получение истории переписки с контактом
//
// Параметры:
//   НомерТелефона - Строка - Номер телефона контакта
//   ИдИнстанса - Строка - Идентификатор инстанса WhatsApp (опционально)
//   ДатаНачала - Дата - Начальная дата для выборки (опционально)
//   ДатаОкончания - Дата - Конечная дата для выборки (опционально)
//   Количество - Число - Максимальное количество сообщений для выборки (опционально)
//
// Возвращаемое значение:
//   Массив - История сообщений или Неопределено при ошибке
//
Функция ПолучитьИсториюПереписки(НомерТелефона, ИдИнстанса = "", 
                               ДатаНачала = Неопределено, ДатаОкончания = Неопределено, 
                               Количество = 0) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(НомерТелефона) Тогда
            ВызватьИсключение "Не указан номер телефона";
        КонецЕсли;
        
        // Форматируем номер телефона
        НомерТелефона = ФорматироватьНомерТелефона(НомерТелефона);
        
        // Формируем запрос для получения истории
        Запрос = Новый Запрос;
        ТекстЗапроса =
        "ВЫБРАТЬ
        |   СообщенияWhatsApp.НомерТелефона,
        |   СообщенияWhatsApp.Текст,
        |   СообщенияWhatsApp.ИдентификаторСообщения,
        |   СообщенияWhatsApp.Исходящее,
        |   СообщенияWhatsApp.Время,
        |   СообщенияWhatsApp.ИнстансWhatsApp,
        |   СообщенияWhatsApp.Статус,
        |   СообщенияWhatsApp.ВремяОбновленияСтатуса,
        |   СообщенияWhatsApp.ЕстьФайл,
        |   СообщенияWhatsApp.ИдентификаторФайла,
        |   СообщенияWhatsApp.ИмяФайла,
        |   СообщенияWhatsApp.ТипФайла
        |ИЗ
        |   РегистрСведений.СообщенияWhatsApp КАК СообщенияWhatsApp
        |ГДЕ
        |   СообщенияWhatsApp.НомерТелефона = &НомерТелефона";
        
        Если Не ПустаяСтрока(ИдИнстанса) Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.ИнстансWhatsApp = &ИнстансWhatsApp";
            Запрос.УстановитьПараметр("ИнстансWhatsApp", ИдИнстанса);
        КонецЕсли;
        
        Если ДатаНачала <> Неопределено Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.Время >= &ДатаНачала";
            Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
        КонецЕсли;
        
        Если ДатаОкончания <> Неопределено Тогда
            ТекстЗапроса = ТекстЗапроса + "
            |   И СообщенияWhatsApp.Время <= &ДатаОкончания";
            Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
        КонецЕсли;
        
        ТекстЗапроса = ТекстЗапроса + "
        |УПОРЯДОЧИТЬ ПО
        |   СообщенияWhatsApp.Время";
        
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
        
        РезультатЗапроса = Запрос.Выполнить();
        
        Если РезультатЗапроса.Пустой() Тогда
            // Если нет сообщений, возвращаем пустой массив
            Возврат Новый Массив;
        КонецЕсли;
        
        // Формируем результат
        Выборка = РезультатЗапроса.Выбрать();
        
        Сообщения = Новый Массив;
        
        ОграничениеДостигнуто = Ложь;
        СчетчикСообщений = 0;
        
        Пока Выборка.Следующий() Цикл
            
            СчетчикСообщений = СчетчикСообщений + 1;
            Если Количество > 0 И СчетчикСообщений > Количество Тогда
                ОграничениеДостигнуто = Истина;
                Прервать;
            КонецЕсли;
            
            СообщениеСтруктура = Новый Структура;
            СообщениеСтруктура.Вставить("НомерТелефона", Выборка.НомерТелефона);
            СообщениеСтруктура.Вставить("Текст", Выборка.Текст);
            СообщениеСтруктура.Вставить("ИдентификаторСообщения", Выборка.ИдентификаторСообщения);
            СообщениеСтруктура.Вставить("Исходящее", Выборка.Исходящее);
            СообщениеСтруктура.Вставить("Время", Выборка.Время);
            СообщениеСтруктура.Вставить("ИнстансWhatsApp", Выборка.ИнстансWhatsApp);
            СообщениеСтруктура.Вставить("Статус", Выборка.Статус);
            СообщениеСтруктура.Вставить("ВремяОбновленияСтатуса", Выборка.ВремяОбновленияСтатуса);
            СообщениеСтруктура.Вставить("ЕстьФайл", Выборка.ЕстьФайл);
            
            Если Выборка.ЕстьФайл Тогда
                СообщениеСтруктура.Вставить("ИдентификаторФайла", Выборка.ИдентификаторФайла);
                СообщениеСтруктура.Вставить("ИмяФайла", Выборка.ИмяФайла);
                СообщениеСтруктура.Вставить("ТипФайла", Выборка.ТипФайла);
            КонецЕсли;
            
            Сообщения.Добавить(СообщениеСтруктура);
        КонецЦикла;
        
        Возврат Сообщения;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьИсториюПереписки: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Получение файла сообщения
//
// Параметры:
//   ИдентификаторФайла - Строка - Идентификатор файла в хранилище
//
// Возвращаемое значение:
//   ДвоичныеДанные - Данные файла или Неопределено при ошибке
//
Функция ПолучитьФайлСообщения(ИдентификаторФайла) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ИдентификаторФайла) Тогда
            ВызватьИсключение "Не указан идентификатор файла";
        КонецЕсли;
        
        // Получаем файл из хранилища файлов 1С
        Возврат ПолучитьДвоичныеДанныеИзХранилищаФайлов(ИдентификаторФайла);
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьФайлСообщения: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Удаление сообщения из хранилища
//
// Параметры:
//   ИдСообщения - Строка - Идентификатор сообщения для удаления
//
// Возвращаемое значение:
//   Булево - Результат удаления
//
Функция УдалитьСообщение(ИдСообщения) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ИдСообщения) Тогда
            ВызватьИсключение "Не указан идентификатор сообщения";
        КонецЕсли;
        
        // Проверяем существование сообщения
        Если Не СообщениеСуществует(ИдСообщения) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                "Сообщение не найдено для удаления: " + ИдСообщения);
            Возврат Ложь;
        КонецЕсли;
        
        // Получаем информацию о сообщении
        Сообщение = ПолучитьСообщение(ИдСообщения);
        
        // Если у сообщения есть файл, удаляем его из хранилища файлов
        Если Сообщение.ЕстьФайл И ЗначениеЗаполнено(Сообщение.ИдентификаторФайла) Тогда
            Попытка
                УдалитьФайлИзХранилища(Сообщение.ИдентификаторФайла);
            Исключение
                ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Предупреждение,,,
                    "Ошибка удаления файла сообщения: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЕсли;
        
        // Удаляем запись из регистра сведений
        МенеджерЗаписи = РегистрыСведений.СообщенияWhatsApp.СоздатьМенеджерЗаписи();
        МенеджерЗаписи.ИдентификаторСообщения = ИдСообщения;
        МенеджерЗаписи.Удалить();
        
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Информация,,,
            "Сообщение удалено: " + ИдСообщения);
            
        Возврат Истина;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppStorage", УровеньЖурналаРегистрации.Ошибка,,,
            "УдалитьСообщение: " + ИнфоОшибки.Описание);
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

// Поиск сообщений по тексту
