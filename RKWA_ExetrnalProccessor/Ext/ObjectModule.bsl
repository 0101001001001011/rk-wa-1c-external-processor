#Область ПрограммныйИнтерфейс

// Выполнить запрос к REST API WhatsApp с поддержкой различных типов авторизации
//
// Параметры:
//  URL - Строка - URL запроса
//  ПараметрыСУ - Структура - Параметры системы управления
//  Метод - Строка - HTTP метод 
//  Данные - Произвольный - Данные запроса
//  Заголовки - Соответствие - Дополнительные заголовки  
//  ТипКонтента - Строка - MIME тип контента
//  ИмяФайла - Строка - Имя файла для multipart/form-data
//
// Возвращаемое значение:
//   Структура - Результат запроса:
//    * КодСостояния - Число - HTTP код ответа
//    * ТелоОтвета - Строка - Тело HTTP ответа
//    * Успех - Булево - Признак успешного выполнения
//    * ЭтоФайл - Булево - Признак ответа в виде файла
//    * ДвоичныеДанные - ДвоичныеДанные - Данные файла (если ЭтоФайл = Истина)
//    * ТипФайла - Строка - MIME тип файла (если ЭтоФайл = Истина)
//
Функция ВыполнитьЗапросREST(URL, ПараметрыСУ, Метод = "GET",
    Данные = Неопределено, Заголовки = Неопределено, 
    ТипКонтента = "application/json", ИмяФайла = "") Экспорт
    
    ПакетОтвета = Новый Структура;
    ПакетОтвета.Вставить("КодСостояния", 	0);
    ПакетОтвета.Вставить("ТелоОтвета", 		"");
    ПакетОтвета.Вставить("Успех", 			Ложь);
    ПакетОтвета.Вставить("ЭтоФайл", 		Ложь);
    ПакетОтвета.Вставить("ДвоичныеДанные", 	Неопределено);
    ПакетОтвета.Вставить("ТипФайла", 		"");
    
    Попытка
        // Формируем соединение
        HTTPСоединение = Новый HTTPСоединение(
            ПараметрыСУ.baseurl,
            ПараметрыСУ.port,,,,, 
            ?(ПараметрыСУ.useSSL, Новый ЗащищенноеСоединениеOpenSSL, Неопределено)
        );
        
        // Формируем базовый URL с параметрами аутентификации
        БазовыйURL = URL;
        
        // Инициализация заголовков, если не переданы
        Если Заголовки = Неопределено Тогда
            Заголовки = Новый Соответствие;
        КонецЕсли;
        
        // Для разных видов аутентификации
        Если ПараметрыСУ.Свойство("authType") Тогда
            Если ПараметрыСУ.authType = "apiKey" Тогда
                Заголовки.Вставить("x-api-key", ПараметрыСУ.apiKey);
            ИначеЕсли ПараметрыСУ.authType = "token" Тогда
                Заголовки.Вставить("Authorization", "Bearer " + ПараметрыСУ.token);
            ИначеЕсли ПараметрыСУ.authType = "basic" Тогда
                // Базовая HTTP-авторизация (логин:пароль в base64)
                ЛогинПароль = ПараметрыСУ.login + ":" + ПараметрыСУ.password;
                Base64Строка = Base64Строка(ПолучитьБуферДвоичныхДанныхИзСтроки(ЛогинПароль, КодировкаТекста.UTF8));
                Заголовки.Вставить("Authorization", "Basic " + Base64Строка);
            КонецЕсли;
        КонецЕсли;
        
        HTTPЗапрос = Новый HTTPЗапрос(БазовыйURL);
        
        // Определяем тип контента и формируем тело
        Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
            // Для отправки файла используем multipart/form-data
            Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
            HTTPЗапрос.Заголовки.Вставить("Content-Type", 
                "multipart/form-data; boundary=" + Разделитель);
                
            ТелоЗапроса = ПодготовитьMultipartЗапрос(Данные, ИмяФайла, Разделитель);
            HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
            
        ИначеЕсли ТипКонтента = "application/json" Тогда
            HTTPЗапрос.Заголовки.Вставить("Content-Type", ТипКонтента);
            Если Данные <> Неопределено Тогда 
                HTTPЗапрос.УстановитьТелоИзСтроки(ЗаписатьВJSON(Данные));
            КонецЕсли;
        Иначе
            HTTPЗапрос.Заголовки.Вставить("Content-Type", ТипКонтента);
            Если Данные <> Неопределено Тогда
                HTTPЗапрос.УстановитьТелоИзСтроки(Данные);
            КонецЕсли;
        КонецЕсли;
        
        // Добавляем пользовательские заголовки
        Для Каждого Заголовок Из Заголовки Цикл
            HTTPЗапрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
        КонецЦикла;
        
        // Выполняем запрос
        Ответ = HTTPСоединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
        
        // Проверяем заголовки ответа на наличие файла
        ТипКонтентаОтвета = НРег(Ответ.Заголовки.Получить("Content-Type"));
        ЭтоФайл = Ложь;
        
        Если ТипКонтентаОтвета <> Неопределено Тогда
            Если СтрНачинаетсяС(ТипКонтентаОтвета, "application/zip") Тогда
                ЭтоФайл = Истина;
                ПакетОтвета.ТипФайла = "application/zip";
            ИначеЕсли СтрНачинаетсяС(ТипКонтентаОтвета, "application/octet-stream") Тогда
                ЭтоФайл = Истина;
                ПакетОтвета.ТипФайла = "application/octet-stream";
            ИначеЕсли СтрНачинаетсяС(ТипКонтентаОтвета, "application/pdf") Тогда
                ЭтоФайл = Истина;
                ПакетОтвета.ТипФайла = "application/pdf";
            ИначеЕсли СтрНачинаетсяС(ТипКонтентаОтвета, "image/") Тогда
                ЭтоФайл = Истина;
                ПакетОтвета.ТипФайла = ТипКонтентаОтвета;
            ИначеЕсли СтрНачинаетсяС(ТипКонтентаОтвета, "audio/") Тогда
                ЭтоФайл = Истина;
                ПакетОтвета.ТипФайла = ТипКонтентаОтвета;
            ИначеЕсли СтрНачинаетсяС(ТипКонтентаОтвета, "video/") Тогда
                ЭтоФайл = Истина;
                ПакетОтвета.ТипФайла = ТипКонтентаОтвета;
            КонецЕсли;
        КонецЕсли;
            
        // Заполняем результат
        ПакетОтвета.КодСостояния = Ответ.КодСостояния;
        ПакетОтвета.Успех = (Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300);
        ПакетОтвета.ЭтоФайл = ЭтоФайл;
        
        Если ЭтоФайл Тогда
            // Если это файл, сохраняем двоичные данные
            ПакетОтвета.ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
            ПакетОтвета.ТелоОтвета = ""; // Для файла текстовое тело не требуется
        Иначе
            // Если не файл, получаем тело как строку
            ПакетОтвета.ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
        КонецЕсли;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
            "ВыполнитьЗапросREST: " + ИнфоОшибки.Описание);
    КонецПопытки;
    
    Возврат ПакетОтвета;
    
КонецФункции

// Цикл опроса сервера WhatsApp API через long polling
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//
Процедура ЦиклОпросаСервера(ПараметрыСУ) Экспорт
    isactive = Истина;
    
    // Проверка аутентификации перед началом цикла
    Если НЕ ПроверитьАутентификацию(ПараметрыСУ) Тогда
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
            "Ошибка аутентификации. Проверьте параметры соединения.");
        Возврат;
    КонецЕсли;
    
    Пока isactive Цикл
        Попытка
            // Получаем статус инстанса
            Ответ = ВыполнитьЗапросREST(
                "/api/whatsapp/" + ПараметрыСУ.instanceId + "/status",
                ПараметрыСУ,
                "GET"
            );
            
            Если Ответ.Успех Тогда
                РезультатОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                
                // Проверяем статус инстанса
                Если РезультатОтвета.ready = Истина Тогда
                    // Получаем последние события
                    ПараметрыЗапроса = Новый Структура;
                    Если ПараметрыСУ.Свойство("lastEventTimestamp") Тогда
                        ПараметрыЗапроса.Вставить("since", ПараметрыСУ.lastEventTimestamp);
                    КонецЕсли;
                    ПараметрыЗапроса.Вставить("limit", 20); // Лимит сообщений за один запрос
                    
                    // Получаем последние события инстанса
                    ОтветСобытия = ВыполнитьЗапросREST(
                        "/api/whatsapp/" + ПараметрыСУ.instanceId + "/events",
                        ПараметрыСУ,
                        "GET",
                        ПараметрыЗапроса
                    );
                    
                    Если ОтветСобытия.Успех Тогда
                        СобытияОтвета = ПрочитатьИзJSON(ОтветСобытия.ТелоОтвета);
                        
                        // Обрабатываем каждое событие
                        Если СобытияОтвета.events.Количество() > 0 Тогда
                            Для Каждого Событие Из СобытияОтвета.events Цикл
                                ОбработатьСобытие(Событие, ПараметрыСУ);
                            КонецЦикла;
                            
                            // Обновляем временную метку для следующего запроса
                            ПараметрыСУ.lastEventTimestamp = СобытияОтвета.latestTimestamp;
                        КонецЕсли;
                    Иначе
                        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                            "Ошибка получения событий: " + ОтветСобытия.КодСостояния);
                    КонецЕсли;
                ИначеЕсли РезультатОтвета.status = "qr_received" Тогда
                    // Если необходимо сканировать QR-код
                    ПолучитьQRКод(ПараметрыСУ);
                ИначеЕсли РезультатОтвета.status = "connecting" Тогда
                    // Инстанс в процессе подключения, ждем
                    ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                        "Инстанс в процессе подключения. Ожидание...");
                Иначе
                    // Инстанс не готов, пробуем инициализировать
                    ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                        "Инстанс не готов. Статус: " + РезультатОтвета.status);
                    
                КонецЕсли;
            КонецЕсли;
                        
            // Проверяем активность задания
            isactive = ПроверитьАктивностьЗадания();
            
            // Сохраняем обновленные параметры
            ОбновитьИнформациюОЗадании(ПараметрыСУ, isactive);
            
        Исключение
            ИнфоОшибки = ИнформацияОбОшибке();
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "ЦиклОпросаСервера: " + ИнфоОшибки.Описание);
                
        КонецПопытки;
    КонецЦикла;
    
КонецПроцедуры

// Отправить сообщение через WhatsApp API
//
// Параметры:
//  ИдЧата - Строка - ID чата/номер телефона получателя
//  Текст - Строка - Текст сообщения
//  ПараметрыСУ - Структура - Параметры системы управления
//
// Возвращаемое значение:
//   Структура - Результат отправки
//
Функция ОтправитьСообщение(ИдЧата, Текст, ПараметрыСУ) Экспорт
   
   Попытка
       // Форматируем тело запроса
       ПараметрыЗапроса = Новый Структура;
       ПараметрыЗапроса.Вставить("phone", ФорматироватьНомерТелефона(ИдЧата));
       ПараметрыЗапроса.Вставить("message", Текст);
       
       Возврат ВыполнитьЗапросREST(
           "/api/instances/" + ПараметрыСУ.instanceId + "/send",
           ПараметрыСУ,
           "POST", 
           ПараметрыЗапроса
       );
       
   Исключение
       ИнфоОшибки = ИнформацияОбОшибке();
       ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
           "ОтправитьСообщение: " + ИнфоОшибки.Описание);
       Возврат Неопределено;
   КонецПопытки;
   
КонецФункции

// Отправка файла
//
// Параметры:
//  ИдЧата - Строка - ID чата/номер телефона получателя
//  ДвоичныеДанные - ДвоичныеДанные - Данные файла для отправки
//  ИмяФайла - Строка - Имя отправляемого файла
//  ПараметрыСУ - Структура - Параметры системы управления
//  Подпись - Строка - Подпись к файлу (необязательно)
//
// Возвращаемое значение:
//   Структура - Результат отправки
//
Функция ОтправитьФайл(ИдЧата, ДвоичныеДанные, ИмяФайла, ПараметрыСУ, Подпись = "") Экспорт
    
    Попытка
        // Форматируем номер телефона
        Телефон = ПравильноОтформатироватьТелефон(ИдЧата);
        
        // Формируем тело запроса
        Разделитель = Строка(Новый УникальныйИдентификатор());
        
        // Формируем основное составное сообщение через поток в памяти
        Тело = Новый ПотокВПамяти();
        ЗаписьДанных = Новый ЗаписьДанных(Тело, КодировкаТекста.UTF8, 
            ПорядокБайтов.LittleEndian, 
            Символы.ВК + Символы.ПС, 
            Символы.ПС, 
            Истина);
        
        // Оставляем phone в теле запроса, а также передаем его в URL
        ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);
        ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""phone""");
        ЗаписьДанных.ЗаписатьСтроку("");
        ЗаписьДанных.ЗаписатьСтроку(Телефон);
        
        // Если есть подпись
        Если НЕ ПустаяСтрока(Подпись) Тогда
            // caption
            ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);
            ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""caption""");
            ЗаписьДанных.ЗаписатьСтроку("");
            ЗаписьДанных.ЗаписатьСтроку(Подпись);
        КонецЕсли;
        
        // file - сам файл
        ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);
        ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """");
        ЗаписьДанных.ЗаписатьСтроку("Content-Type: application/octet-stream");
        ЗаписьДанных.ЗаписатьСтроку("");
        ЗаписьДанных.Записать(ДвоичныеДанные);
        ЗаписьДанных.ЗаписатьСтроку("");
        
        // Завершающий разделитель
        ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--");
        ЗаписьДанных.Закрыть();
        
        ДанныеТела = Тело.ЗакрытьИПолучитьДвоичныеДанные();
        
        // Формируем соединение и запрос
        HTTPСоединение = Новый HTTPСоединение(
            ПараметрыСУ.baseurl,
            ПараметрыСУ.port,,,,, 
            ?(ПараметрыСУ.useSSL, Новый ЗащищенноеСоединениеOpenSSL, Неопределено)
        );
        
        // Формируем заголовки запроса
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
        Заголовки.Вставить("Accept", "*/*");
        Заголовки.Вставить("Content-Length", Формат(ДанныеТела.Размер(), "ЧДЦ=0; ЧН=0; ЧГ=0"));
        
        // Добавляем заголовки авторизации
        Если ПараметрыСУ.authType = "apiKey" Тогда
            Заголовки.Вставить("x-api-key", ПараметрыСУ.apiKey);
        ИначеЕсли ПараметрыСУ.authType = "token" Тогда
            Заголовки.Вставить("Authorization", "Bearer " + ПараметрыСУ.token);
        КонецЕсли;
        
        // Создаем HTTP запрос с параметрами в URL
        URL = "/api/whatsapp/" + ПараметрыСУ.instanceId + "/send-file?phone=" + Телефон;
        HTTPЗапрос = Новый HTTPЗапрос(URL, Заголовки);
        HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ДанныеТела);
        
        // Отправляем запрос
        HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("КодСостояния", HTTPОтвет.КодСостояния);
        Результат.Вставить("ТелоОтвета", HTTPОтвет.ПолучитьТелоКакСтроку());
        Результат.Вставить("Успех", (HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300));
        
        // Логируем результат
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,,
            "Результат отправки файла:" + Символы.ПС +
            "КодСостояния: " + Результат.КодСостояния + Символы.ПС +
            "ТелоОтвета: " + Результат.ТелоОтвета + Символы.ПС +
            "Телефон: " + Телефон);
            
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ОтправитьФайл: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Функция для форматирования номера телефона
Функция ПравильноОтформатироватьТелефон(Знач НомерТелефона) Экспорт
    // Строка для результата
    Результат = "";
    
    // Проверяем тип данных
    Если ТипЗнч(НомерТелефона) = Тип("Строка") Тогда
        // Оставляем только цифры
        Для Индекс = 1 По СтрДлина(НомерТелефона) Цикл
            Символ = Сред(НомерТелефона, Индекс, 1);
            Если Найти("0123456789", Символ) > 0 Тогда
                Результат = Результат + Символ;
            КонецЕсли;
        КонецЦикла;
    ИначеЕсли ТипЗнч(НомерТелефона) = Тип("Число") Тогда 
        // Если число, просто преобразуем в строку
        Результат = Строка(НомерТелефона);
    Иначе
        // Другие типы - преобразуем в строку и очищаем от нецифровых символов
        СтрНомер = Строка(НомерТелефона);
        Для Индекс = 1 По СтрДлина(СтрНомер) Цикл
            Символ = Сред(СтрНомер, Индекс, 1);
            Если Найти("0123456789", Символ) > 0 Тогда
                Результат = Результат + Символ;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

// Получить QR-код для сканирования
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//
// Возвращаемое значение:
//   Структура - Данные QR-кода или Неопределено при ошибке
//
Функция ПолучитьQRКод(ПараметрыСУ) Экспорт
    
    Попытка
        // Запрос на получение QR-кода
        Ответ = ВыполнитьЗапросREST(
            "/api/whatsapp/" + ПараметрыСУ.instanceId + "/qr",
            ПараметрыСУ,
            "GET"
        );
        
        Если Ответ.Успех Тогда
            РезультатОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            Если РезультатОтвета.Свойство("qrCode") И ЗначениеЗаполнено(РезультатОтвета.qrCode) Тогда
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                    "Получен QR-код для сканирования. Откройте WhatsApp на телефоне и отсканируйте код.");
                    
                // Сохраняем QR код в файл для последующего использования
                СохранитьQRКодВФайл(РезультатОтвета.qrCode, ПараметрыСУ.instanceId);
                
                Возврат РезультатОтвета;
            Иначе
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                    "QR-код не доступен в ответе API: " + Ответ.ТелоОтвета);
                Возврат Неопределено;
            КонецЕсли;
        ИначеЕсли Ответ.КодСостояния = 202 Тогда  // Accepted - QR код генерируется
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "QR-код генерируется, повторите запрос позже");
            Возврат Неопределено;
        Иначе
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка получения QR-кода: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
            Возврат Неопределено;
        КонецЕсли;
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьQRКод: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

// Получение всех инстансов пользователя
//
// Параметры:
//   ПараметрыСУ - Структура - Параметры системы управления
//   ПреобразоватьВРусские - Булево - Преобразовывать ли в структуры с русскими названиями (по умолчанию Истина)
//
// Возвращаемое значение:
//   Структура - Результат получения списка инстансов:
//    * Успех - Булево - Признак успешного получения данных
//    * Инстансы - Массив - Массив инстансов (структуры или исходные объекты)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном получении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция ОтключитьИнстанс(ПараметрыСУ, ПреобразоватьВРусские = Ложь) Экспорт
    
    Попытка
        // Проверка параметров авторизации
        Если НЕ ПараметрыСУ.Свойство("authType") Тогда
            // Если не указан тип авторизации, используем токен по умолчанию
            // при условии, что токен существует
            Если ПараметрыСУ.Свойство("token") И ЗначениеЗаполнено(ПараметрыСУ.token) Тогда
                ПараметрыСУ.Вставить("authType", "token");
            ИначеЕсли ПараметрыСУ.Свойство("apiKey") И ЗначениеЗаполнено(ПараметрыСУ.apiKey) Тогда
                ПараметрыСУ.Вставить("authType", "apiKey");
            Иначе
                ВызватьИсключение "Не указаны данные авторизации (токен или API ключ)";
            КонецЕсли;
        КонецЕсли;
        
        // Проверяем наличие необходимых параметров в зависимости от типа авторизации
        Если ПараметрыСУ.authType = "token" И (НЕ ПараметрыСУ.Свойство("token") ИЛИ ПустаяСтрока(ПараметрыСУ.token)) Тогда
            ВызватьИсключение "Не указан токен авторизации";
        ИначеЕсли ПараметрыСУ.authType = "apiKey" И (НЕ ПараметрыСУ.Свойство("apiKey") ИЛИ ПустаяСтрока(ПараметрыСУ.apiKey)) Тогда
            ВызватьИсключение "Не указан ключ API";
        КонецЕсли;
        
        // Выполняем запрос на получение списка инстансов
        Ответ = ВыполнитьЗапросREST(
            "/api/instances/" + ПараметрыСУ.Идентификатор + "/logout",
            ПараметрыСУ,
            "POST"
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            Если ДанныеОтвета.Свойство("instances") Тогда
                // Преобразуем инстансы, если требуется
                Если ПреобразоватьВРусские Тогда
                    Результат.Вставить("Инстансы", ПреобразоватьИнстансы(ДанныеОтвета.instances));
                Иначе
                    Результат.Вставить("Инстансы", ДанныеОтвета.instances);
                КонецЕсли;
                
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                    "Получено " + ДанныеОтвета.instances.Количество() + " инстансов");
            Иначе
                // Если нет инстансов, возвращаем пустой массив
                Если ПреобразоватьВРусские Тогда
                    Результат.Вставить("Инстансы", ПреобразоватьИнстансы(Новый Массив));
                Иначе
                    Результат.Вставить("Инстансы", Новый Массив);
                КонецЕсли;
                
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                    "В ответе API отсутствуют инстансы");
            КонецЕсли;
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка получения списка инстансов");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка получения списка инстансов");
            КонецЕсли;
            
            // Если код ответа 401 или 403, значит проблемы с авторизацией
            Если Ответ.КодСостояния = 401 ИЛИ Ответ.КодСостояния = 403 Тогда
                // Сбрасываем флаг авторизации в настройках
                НастройкиАвторизации = ЗагрузитьОбщиеНастройки();
                НастройкиАвторизации.Авторизован = Ложь;
                СохранитьОбщиеНастройки("RKWA1C", "Authorization", НастройкиАвторизации);
                
                Результат.Вставить("Сообщение", "Ошибка авторизации. Необходимо повторно авторизоваться.");
            КонецЕсли;
            
            // Добавляем пустой массив инстансов
            Если ПреобразоватьВРусские Тогда
                Результат.Вставить("Инстансы", ПреобразоватьИнстансы(Новый Массив));
            Иначе
                Результат.Вставить("Инстансы", Новый Массив);
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка получения списка инстансов: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьСписокИнстансов: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        // Добавляем пустой массив инстансов
        Если ПреобразоватьВРусские Тогда
            Результат.Вставить("Инстансы", ПреобразоватьИнстансы(Новый Массив));
        Иначе
            Результат.Вставить("Инстансы", Новый Массив);
        КонецЕсли;
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Проверка авторизации API
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//
// Возвращаемое значение:
//   Булево - Результат проверки авторизации
//
Функция ПроверитьАутентификацию(ПараметрыСУ) Экспорт
    
    Попытка
        // Проверка корректности параметров
        Если НЕ ПараметрыСУ.Свойство("instanceId") ИЛИ ПустаяСтрока(ПараметрыСУ.instanceId) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Не указан идентификатор инстанса (instanceId)");
            Возврат Ложь;
        КонецЕсли;
        
        Если НЕ ПараметрыСУ.Свойство("baseurl") ИЛИ ПустаяСтрока(ПараметрыСУ.baseurl) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Не указан базовый URL сервера (baseurl)");
            Возврат Ложь;
        КонецЕсли;
        
        Если НЕ ПараметрыСУ.Свойство("authType") ИЛИ ПустаяСтрока(ПараметрыСУ.authType) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Не указан тип авторизации (authType)");
            Возврат Ложь;
        КонецЕсли;
        
        // Проверка параметров аутентификации в зависимости от типа
        Если ПараметрыСУ.authType = "apiKey" И (НЕ ПараметрыСУ.Свойство("apiKey") ИЛИ ПустаяСтрока(ПараметрыСУ.apiKey)) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Не указан API ключ (apiKey)");
            Возврат Ложь;
        КонецЕсли;
        
        Если ПараметрыСУ.authType = "token" И (НЕ ПараметрыСУ.Свойство("token") ИЛИ ПустаяСтрока(ПараметрыСУ.token)) Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Не указан токен авторизации (token)");
            Возврат Ложь;
        КонецЕсли;
        
        // Выполняем тестовый запрос к API для проверки аутентификации
        Ответ = ВыполнитьЗапросREST(
            "/api/instances/" + ПараметрыСУ.instanceId,
            ПараметрыСУ,
            "GET"
        );
        
        Если Ответ.Успех Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Аутентификация успешна");
            Возврат Истина;
        ИначеЕсли Ответ.КодСостояния = 401 ИЛИ Ответ.КодСостояния = 403 Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка аутентификации: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
            Возврат Ложь;
        Иначе
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка проверки аутентификации: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
            Возврат Ложь;
        КонецЕсли;
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПроверитьАутентификацию: " + ИнфоОшибки.Описание);
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

// Получение контактов из WhatsApp и/или базы данных
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//  ИсточникКонтактов - Строка - Источник получения контактов ("whatsapp", "db" или "all"; по умолчанию "all")
//  ПреобразоватьВРусские - Булево - Преобразовывать ли в структуры с русскими названиями (по умолчанию Истина)
//  ПараметрыПоиска - Структура - Дополнительные параметры для поиска в БД (limit, skip, searchTerm, onlyGroups)
//
// Возвращаемое значение:
//   Структура - Результат получения списка контактов:
//    * Успех - Булево - Признак успешного получения данных
//    * Контакты - Массив - Массив контактов (структуры или исходные объекты)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном получении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция ПолучитьКонтакты(ПараметрыСУ, ИсточникКонтактов = "all", ПреобразоватьВРусские = Истина, ПараметрыПоиска = Неопределено) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ПараметрыСУ.instanceId) Тогда
            ВызватьИсключение "Не указан идентификатор инстанса (instanceId)";
        КонецЕсли;
        
        // Результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("КодСостояния", 0);
        Результат.Вставить("Контакты", Новый Массив);
        
        // Инициализируем общий массив контактов
        ОбщийМассивКонтактов = Новый Массив;
        
        // Получение контактов из WhatsApp
        Если ИсточникКонтактов = "whatsapp" ИЛИ ИсточникКонтактов = "all" Тогда
            // Выполняем запрос на получение списка контактов из WhatsApp
            Ответ = ВыполнитьЗапросREST(
                "/api/whatsapp/" + ПараметрыСУ.instanceId + "/contacts",
                ПараметрыСУ,
                "GET"
            );
            
            Если Ответ.Успех Тогда
                // Разбираем ответ сервера
                ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                
                Если ДанныеОтвета.Свойство("contacts") Тогда
                    // Добавляем контакты из WhatsApp в общий массив
                    Для Каждого Контакт Из ДанныеОтвета.contacts Цикл
                        ОбщийМассивКонтактов.Добавить(Контакт);
                    КонецЦикла;
                    
                    ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                        "Получено " + ДанныеОтвета.contacts.Количество() + " контактов из WhatsApp");
                КонецЕсли;
                
                // Устанавливаем статус успешного выполнения
                Результат.Успех = Истина;
                Результат.КодСостояния = Ответ.КодСостояния;
            Иначе
                // Разбираем ошибку
                Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                    Попытка
                        ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                        Результат.Вставить("Сообщение", ДанныеОшибки.error);
                    Исключение
                        Результат.Вставить("Сообщение", "Ошибка получения списка контактов из WhatsApp");
                    КонецПопытки;
                Иначе
                    Результат.Вставить("Сообщение", "Ошибка получения списка контактов из WhatsApp");
                КонецЕсли;
                
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Ошибка получения списка контактов из WhatsApp: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
                
                // Если запрашивается только WhatsApp - возвращаем ошибку
                Если ИсточникКонтактов = "whatsapp" Тогда
                    Возврат Результат;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        
        // Получение контактов из БД
        Если ИсточникКонтактов = "db" ИЛИ ИсточникКонтактов = "all" Тогда
            // Формируем параметры запроса для БД
            Если ПараметрыПоиска = Неопределено Тогда
                ПараметрыПоиска = Новый Структура;
            КонецЕсли;
            
            // Устанавливаем параметры по умолчанию, если не заданы
            Если НЕ ПараметрыПоиска.Свойство("limit") Тогда
                ПараметрыПоиска.Вставить("limit", 100);
            КонецЕсли;
            
            Если НЕ ПараметрыПоиска.Свойство("skip") Тогда
                ПараметрыПоиска.Вставить("skip", 0);
            КонецЕсли;
            
            // Выполняем запрос на получение списка контактов из БД
            ОтветDB = ВыполнитьЗапросREST(
                "/api/instances/" + ПараметрыСУ.instanceId + "/contacts/db",
                ПараметрыСУ,
                "GET",
                ПараметрыПоиска
            );
            
            Если ОтветDB.Успех Тогда
                // Разбираем ответ сервера
                ДанныеОтвета = ПрочитатьИзJSON(ОтветDB.ТелоОтвета);
                
                Если ДанныеОтвета.Свойство("contacts") Тогда
                    // Добавляем контакты из БД в общий массив
                    Для Каждого Контакт Из ДанныеОтвета.contacts Цикл
                        // Преобразуем формат контакта из БД к формату WhatsApp для единообразия
                        КонтактWhatsAppФормат = Новый Структура;
                        КонтактWhatsAppФормат.Вставить("id", Контакт.remoteJid);
                        КонтактWhatsAppФормат.Вставить("name", ?(ЗначениеЗаполнено(Контакт.name), Контакт.name, Контакт.pushName));
                        КонтактWhatsAppФормат.Вставить("number", Контакт.number);
                        КонтактWhatsAppФормат.Вставить("isGroup", Контакт.isGroup);
                        
                        // Добавляем в общий массив
                        ОбщийМассивКонтактов.Добавить(КонтактWhatsAppФормат);
                    КонецЦикла;
                    
                    ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                        "Получено " + ДанныеОтвета.contacts.Количество() + " контактов из БД");
                КонецЕсли;
                
                // Устанавливаем статус успешного выполнения
                Результат.Успех = Истина;
                Результат.КодСостояния = ОтветDB.КодСостояния;
            Иначе
                // Разбираем ошибку
                Если ЗначениеЗаполнено(ОтветDB.ТелоОтвета) Тогда
                    Попытка
                        ДанныеОшибки = ПрочитатьИзJSON(ОтветDB.ТелоОтвета);
                        Результат.Вставить("Сообщение", ДанныеОшибки.error);
                    Исключение
                        Результат.Вставить("Сообщение", "Ошибка получения списка контактов из БД");
                    КонецПопытки;
                Иначе
                    Результат.Вставить("Сообщение", "Ошибка получения списка контактов из БД");
                КонецЕсли;
                
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                    "Ошибка получения списка контактов из БД: " + ОтветDB.КодСостояния + Символы.ПС + ОтветDB.ТелоОтвета);
                
                // Если запрашивается только DB и уже нет контактов из WhatsApp, возвращаем ошибку
                Если ИсточникКонтактов = "db" И ОбщийМассивКонтактов.Количество() = 0 Тогда
                    Возврат Результат;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        
        // Удаляем дубликаты по номеру телефона
        УникальныеКонтакты = Новый Соответствие;
        
        Для Каждого Контакт Из ОбщийМассивКонтактов Цикл
            Ключ = Контакт.number;
            Если Не УникальныеКонтакты.Получить(Ключ) = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            
            УникальныеКонтакты.Вставить(Ключ, Контакт);
        КонецЦикла;
        
        // Формируем окончательный массив уникальных контактов
        МассивУникальныхКонтактов = Новый Массив;
        
        Для Каждого КлючИЗначение Из УникальныеКонтакты Цикл
            МассивУникальныхКонтактов.Добавить(КлючИЗначение.Значение);
        КонецЦикла;
        
        // Преобразуем контакты, если требуется
        Если ПреобразоватьВРусские Тогда
            Результат.Вставить("Контакты", ПреобразоватьКонтакты(МассивУникальныхКонтактов));
        Иначе
            Результат.Вставить("Контакты", МассивУникальныхКонтактов);
        КонецЕсли;
        
        // Если мы дошли до этого места и есть хотя бы один контакт, считаем операцию успешной
        Если МассивУникальныхКонтактов.Количество() > 0 Тогда
            Результат.Успех = Истина;
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьСписокКонтактов: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        // Добавляем пустой массив контактов
        Если ПреобразоватьВРусские Тогда
            Результат.Вставить("Контакты", ПреобразоватьКонтакты(Новый Массив));
        Иначе
            Результат.Вставить("Контакты", Новый Массив);
        КонецЕсли;
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Редактировать существующий контакт в базе данных
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//  КонтактСтруктура - Структура - Данные контакта с русскими названиями полей
//  ИдКонтакта - Строка - Идентификатор (remoteJid) контакта, который нужно отредактировать
//  
// Возвращаемое значение:
//   Структура - Результат операции:
//    * Успех - Булево - Признак успешного редактирования
//    * Контакт - Структура - Данные отредактированного контакта (если успешно)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном редактировании)
//    * КодСостояния - Число - HTTP код состояния
//
Функция РедактироватьКонтактВБД(ПараметрыСУ, КонтактСтруктура, ИдКонтакта = "") Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ПараметрыСУ.instanceId) Тогда
            ВызватьИсключение "Не указан идентификатор инстанса (instanceId)";
        КонецЕсли;
        
        Если КонтактСтруктура = Неопределено Тогда
            ВызватьИсключение "Не указаны данные контакта";
        КонецЕсли;
        
        // Если ИдКонтакта не указан, используем Идентификатор из структуры
        Если ПустаяСтрока(ИдКонтакта) Тогда
            Если НЕ КонтактСтруктура.Свойство("Идентификатор") ИЛИ ПустаяСтрока(КонтактСтруктура.Идентификатор) Тогда
                // Если нет идентификатора, используем номер для его формирования
                Если НЕ КонтактСтруктура.Свойство("Номер") ИЛИ ПустаяСтрока(КонтактСтруктура.Номер) Тогда
                    ВызватьИсключение "Не указан идентификатор контакта и номер телефона";
                КонецЕсли;
                
                // Формируем идентификатор из номера
                ИдКонтакта = КонтактСтруктура.Номер + ?(КонтактСтруктура.ЭтоГруппа, "@g.us", "@s.whatsapp.net");
            Иначе
                ИдКонтакта = КонтактСтруктура.Идентификатор;
            КонецЕсли;
        КонецЕсли;
        
        // Преобразуем контакт из структуры с русскими названиями в формат API
        КонтактДанные = Новый Структура;
        
        // Устанавливаем существующий remoteJid
        КонтактДанные.Вставить("remoteJid", ИдКонтакта);
        
        // Если в идентификаторе нет @, добавляем соответствующий суффикс
        Если СтрНайти(ИдКонтакта, "@") = 0 Тогда
            КонтактДанные.Вставить("remoteJid", ИдКонтакта + ?(КонтактСтруктура.ЭтоГруппа, "@g.us", "@s.whatsapp.net"));
        КонецЕсли;
        
        // Номер телефона (извлекаем из remoteJid или берем из структуры)
        Если СтрНайти(ИдКонтакта, "@") > 0 Тогда
            КонтактДанные.Вставить("number", СтрРазделить(ИдКонтакта, "@")[0]);
        ИначеЕсли КонтактСтруктура.Свойство("Номер") И ЗначениеЗаполнено(КонтактСтруктура.Номер) Тогда
            КонтактДанные.Вставить("number", КонтактСтруктура.Номер);
        Иначе
            КонтактДанные.Вставить("number", ИдКонтакта); // Используем идентификатор как номер
        КонецЕсли;
        
        // Добавляем имя
        Если КонтактСтруктура.Свойство("Имя") И ЗначениеЗаполнено(КонтактСтруктура.Имя) Тогда
            КонтактДанные.Вставить("name", КонтактСтруктура.Имя);
        КонецЕсли;
        
        // Флаг группы
        КонтактДанные.Вставить("isGroup", ?(КонтактСтруктура.Свойство("ЭтоГруппа"), КонтактСтруктура.ЭтоГруппа, Ложь));
        
        // Выполняем запрос на обновление контакта в БД
        Ответ = ВыполнитьЗапросREST(
            "/api/instances/" + ПараметрыСУ.instanceId + "/contacts/save",
            ПараметрыСУ,
            "POST",
            КонтактДанные
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            // Преобразуем полученный контакт обратно в структуру с русскими именами
            ОбновленныйКонтакт = Новый Структура;
            ОбновленныйКонтакт.Вставить("Идентификатор", ДанныеОтвета.remoteJid);
            ОбновленныйКонтакт.Вставить("Имя", ДанныеОтвета.name);
            ОбновленныйКонтакт.Вставить("Номер", ДанныеОтвета.number);
            ОбновленныйКонтакт.Вставить("ЭтоГруппа", ДанныеОтвета.isGroup);
            
            // Добавляем дополнительные поля, если они есть в ответе
            Если ДанныеОтвета.Свойство("pushName") И ЗначениеЗаполнено(ДанныеОтвета.pushName) Тогда
                ОбновленныйКонтакт.Вставить("ОтображаемоеИмя", ДанныеОтвета.pushName);
            КонецЕсли;
            
            Если ДанныеОтвета.Свойство("profilePicture") И ЗначениеЗаполнено(ДанныеОтвета.profilePicture) Тогда
                ОбновленныйКонтакт.Вставить("Аватар", ДанныеОтвета.profilePicture);
            КонецЕсли;
            
            Результат.Вставить("Контакт", ОбновленныйКонтакт);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Контакт успешно обновлен: " + ДанныеОтвета.remoteJid);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка обновления контакта");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка обновления контакта");
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка обновления контакта: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "РедактироватьКонтактВБД: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Добавить или обновить контакт в базе данных
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//  КонтактСтруктура - Структура - Данные контакта с русскими названиями полей
//  
// Возвращаемое значение:
//   Структура - Результат операции:
//    * Успех - Булево - Признак успешного добавления/обновления
//    * Контакт - Структура - Данные добавленного/обновленного контакта (если успешно)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном добавлении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция ДобавитьКонтактВБД(ПараметрыСУ, КонтактСтруктура) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ПараметрыСУ.instanceId) Тогда
            ВызватьИсключение "Не указан идентификатор инстанса (instanceId)";
        КонецЕсли;
        
        Если КонтактСтруктура = Неопределено Тогда
            ВызватьИсключение "Не указаны данные контакта";
        КонецЕсли;
        
        Если НЕ КонтактСтруктура.Свойство("Номер") ИЛИ ПустаяСтрока(КонтактСтруктура.Номер) Тогда
            ВызватьИсключение "Не указан номер телефона контакта";
        КонецЕсли;
        
        // Преобразуем контакт из структуры с русскими названиями в формат API
        КонтактДанные = Новый Структура;
        
        // Форматирование номера и определение remoteJid
        НомерТелефона = КонтактСтруктура.Номер;
        // Если уже есть @ в номере, считаем его полным JID
        Если СтрНайти(НомерТелефона, "@") > 0 Тогда
            КонтактДанные.Вставить("remoteJid", НомерТелефона);
            // Извлекаем чистый номер из JID
            КонтактДанные.Вставить("number", СтрРазделить(НомерТелефона, "@")[0]);
        Иначе
            // Форматируем номер в JID
            КонтактДанные.Вставить("number", НомерТелефона);
            КонтактДанные.Вставить("remoteJid", НомерТелефона + ?(КонтактСтруктура.ЭтоГруппа, "@g.us", "@s.whatsapp.net"));
        КонецЕсли;
        
        // Добавляем имя
        Если КонтактСтруктура.Свойство("Имя") И ЗначениеЗаполнено(КонтактСтруктура.Имя) Тогда
            КонтактДанные.Вставить("name", КонтактСтруктура.Имя);
        КонецЕсли;
        
        // Флаг группы
        КонтактДанные.Вставить("isGroup", ?(КонтактСтруктура.Свойство("ЭтоГруппа"), КонтактСтруктура.ЭтоГруппа, Ложь));
        
        // Выполняем запрос на добавление/обновление контакта в БД
        Ответ = ВыполнитьЗапросREST(
            "/api/instances/" + ПараметрыСУ.instanceId + "/contacts/save",
            ПараметрыСУ,
            "POST",
            КонтактДанные
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            // Преобразуем полученный контакт обратно в структуру с русскими именами
            СохраненныйКонтакт = Новый Структура;
            СохраненныйКонтакт.Вставить("Идентификатор", ДанныеОтвета.remoteJid);
            СохраненныйКонтакт.Вставить("Имя", ДанныеОтвета.name);
            СохраненныйКонтакт.Вставить("Номер", ДанныеОтвета.number);
            СохраненныйКонтакт.Вставить("ЭтоГруппа", ДанныеОтвета.isGroup);
            
            Результат.Вставить("Контакт", СохраненныйКонтакт);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Контакт успешно сохранен: " + ДанныеОтвета.number);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка сохранения контакта");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка сохранения контакта");
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка сохранения контакта: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ДобавитьКонтактВБД: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Удалить контакт из базы данных
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//  ИдКонтакта - Строка - Идентификатор контакта (remoteJid) для удаления
//  
// Возвращаемое значение:
//   Структура - Результат операции:
//    * Успех - Булево - Признак успешного удаления
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном удалении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция УдалитьКонтактИзБД(ПараметрыСУ, ИдКонтакта) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(ПараметрыСУ.instanceId) Тогда
            ВызватьИсключение "Не указан идентификатор инстанса (instanceId)";
        КонецЕсли;
        
        Если ПустаяСтрока(ИдКонтакта) Тогда
            ВызватьИсключение "Не указан идентификатор контакта";
        КонецЕсли;
        
        // Сначала пробуем DELETE запрос
        Ответ = ВыполнитьЗапросREST(
            "/api/instances/" + ПараметрыСУ.instanceId + "/contacts/" + ИдКонтакта,
            ПараметрыСУ,
            "DELETE"
        );
        
        // Если этот эндпоинт не существует, пробуем POST запрос
        Если Ответ.КодСостояния = 404 Тогда
            // Вариант с POST запросом
            ДанныеКонтакта = Новый Структура;
            ДанныеКонтакта.Вставить("remoteJid", ИдКонтакта);
            
            Ответ = ВыполнитьЗапросREST(
                "/api/instances/" + ПараметрыСУ.instanceId + "/contacts/delete",
                ПараметрыСУ,
                "POST",
                ДанныеКонтакта
            );
        КонецЕсли;
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Контакт успешно удален: " + ИдКонтакта);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка удаления контакта");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка удаления контакта");
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка удаления контакта: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "УдалитьКонтактИзБД: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Получить историю сообщений чата
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//  ИдЧата - Строка - ID чата/номер телефона
//  Опции - Структура - Дополнительные параметры (limit, skip, startDate, endDate)
//
// Возвращаемое значение:
//   Структура - История сообщений или Неопределено при ошибке
//
Функция ПолучитьИсториюЧата(ПараметрыСУ, ИдЧата, Опции = Неопределено) Экспорт
    
    Попытка
        // Форматируем номер телефона
        ФорматированныйИдЧата = ФорматироватьНомерТелефона(ИдЧата);
        
        // Подготавливаем параметры запроса
        ПараметрыЗапроса = Новый Структура;
        
        Если Опции <> Неопределено Тогда
            Если Опции.Свойство("limit") Тогда
                ПараметрыЗапроса.Вставить("limit", Опции.limit);
            КонецЕсли;
            
            Если Опции.Свойство("skip") Тогда
                ПараметрыЗапроса.Вставить("skip", Опции.skip);
            КонецЕсли;
            
            Если Опции.Свойство("startDate") Тогда
                ПараметрыЗапроса.Вставить("startDate", Опции.startDate);
            КонецЕсли;
            
            Если Опции.Свойство("endDate") Тогда
                ПараметрыЗапроса.Вставить("endDate", Опции.endDate);
            КонецЕсли;
        КонецЕсли;
        
        // Выполняем запрос к API
        Ответ = ВыполнитьЗапросREST(
            "/api/instances/" + ПараметрыСУ.instanceId + "/chats/" + ФорматированныйИдЧата + "/messages",
            ПараметрыСУ,
            "GET",
            ПараметрыЗапроса
        );
        
        Если Ответ.Успех Тогда
            РезультатОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Получено сообщений: " + ?(РезультатОтвета.Свойство("messages"), РезультатОтвета.messages.Количество(), 0));
            Возврат РезультатОтвета;
        Иначе
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка получения истории сообщений: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
            Возврат Неопределено;
        КонецЕсли;
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьИсториюЧата: " + ИнфоОшибки.Описание);
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

