// Получение всех инстансов пользователя
//
// Параметры:
//   ПараметрыСУ - Структура - Параметры системы управления
//   ПреобразоватьВРусские - Булево - Преобразовывать ли в структуры с русскими названиями (по умолчанию Истина)
//
// Возвращаемое значение:
//   Структура - Результат получения списка инстансов:
//    * Успех - Булево - Признак успешного получения данных
//    * Инстансы - Массив - Массив инстансов (структуры или исходные объекты)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном получении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция ПолучитьСписокИнстансов(ПараметрыСУ, ПреобразоватьВРусские = Истина) Экспорт
    
    Попытка
        // Проверка параметров авторизации
        Если НЕ ПараметрыСУ.Свойство("authType") Тогда
            // Если не указан тип авторизации, используем токен по умолчанию
            // при условии, что токен существует
            Если ПараметрыСУ.Свойство("token") И ЗначениеЗаполнено(ПараметрыСУ.token) Тогда
                ПараметрыСУ.Вставить("authType", "token");
            ИначеЕсли ПараметрыСУ.Свойство("apiKey") И ЗначениеЗаполнено(ПараметрыСУ.apiKey) Тогда
                ПараметрыСУ.Вставить("authType", "apiKey");
            Иначе
                ВызватьИсключение "Не указаны данные авторизации (токен или API ключ)";
            КонецЕсли;
        КонецЕсли;
        
        // Проверяем наличие необходимых параметров в зависимости от типа авторизации
        Если ПараметрыСУ.authType = "token" И (НЕ ПараметрыСУ.Свойство("token") ИЛИ ПустаяСтрока(ПараметрыСУ.token)) Тогда
            ВызватьИсключение "Не указан токен авторизации";
        ИначеЕсли ПараметрыСУ.authType = "apiKey" И (НЕ ПараметрыСУ.Свойство("apiKey") ИЛИ ПустаяСтрока(ПараметрыСУ.apiKey)) Тогда
            ВызватьИсключение "Не указан ключ API";
        КонецЕсли;
        
        // Выполняем запрос на получение списка инстансов
        Ответ = ВыполнитьЗапросREST(
            "/api/instances",
            ПараметрыСУ,
            "GET"
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            Если ДанныеОтвета.Свойство("instances") Тогда
                // Преобразуем инстансы, если требуется
                Если ПреобразоватьВРусские Тогда
                    Результат.Вставить("Инстансы", ПреобразоватьИнстансы(ДанныеОтвета.instances));
                Иначе
                    Результат.Вставить("Инстансы", ДанныеОтвета.instances);
                КонецЕсли;
                
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                    "Получено " + ДанныеОтвета.instances.Количество() + " инстансов");
            Иначе
                // Если нет инстансов, возвращаем пустой массив
                Если ПреобразоватьВРусские Тогда
                    Результат.Вставить("Инстансы", ПреобразоватьИнстансы(Новый Массив));
                Иначе
                    Результат.Вставить("Инстансы", Новый Массив);
                КонецЕсли;
                
                ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                    "В ответе API отсутствуют инстансы");
            КонецЕсли;
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка получения списка инстансов");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка получения списка инстансов");
            КонецЕсли;
            
            // Если код ответа 401 или 403, значит проблемы с авторизацией
            Если Ответ.КодСостояния = 401 ИЛИ Ответ.КодСостояния = 403 Тогда
                // Сбрасываем флаг авторизации в настройках
                НастройкиАвторизации = ЗагрузитьОбщиеНастройки();
                НастройкиАвторизации.Авторизован = Ложь;
                СохранитьОбщиеНастройки("RKWA1C", "Authorization", НастройкиАвторизации);
                
                Результат.Вставить("Сообщение", "Ошибка авторизации. Необходимо повторно авторизоваться.");
            КонецЕсли;
            
            // Добавляем пустой массив инстансов
            Если ПреобразоватьВРусские Тогда
                Результат.Вставить("Инстансы", ПреобразоватьИнстансы(Новый Массив));
            Иначе
                Результат.Вставить("Инстансы", Новый Массив);
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,, 
                "Ошибка получения списка инстансов: " + Ответ.КодСостояния + Символы.ПС + Ответ.ТелоОтвета);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьСписокИнстансов: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        // Добавляем пустой массив инстансов
        Если ПреобразоватьВРусские Тогда
            Результат.Вставить("Инстансы", ПреобразоватьИнстансы(Новый Массив));
        Иначе
            Результат.Вставить("Инстансы", Новый Массив);
        КонецЕсли;
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Выполнить авторизацию по логину и паролю
//
// Параметры:
//  Логин - Строка - Email пользователя
//  Пароль - Строка - Пароль пользователя
//  Настройки - Структура - Настройки соединения (baseurl, port, useSSL)
//
// Возвращаемое значение:
//   Структура - Результат авторизации:
//    * Успех - Булево - Признак успешной авторизации
//    * Токен - Строка - JWT токен (заполняется при успешной авторизации)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешной авторизации)
//    * КодСостояния - Число - HTTP код состояния
//    * Пользователь - Структура - Данные пользователя (заполняется при успешной авторизации)
//
Функция ВыполнитьАвторизацию(Логин, Пароль, Настройки) Экспорт
    
    Попытка
        // Проверка параметров
        Если ПустаяСтрока(Логин) Тогда
            ВызватьИсключение "Не указан логин";
        КонецЕсли;
        
        Если ПустаяСтрока(Пароль) Тогда
            ВызватьИсключение "Не указан пароль";
        КонецЕсли;
        
        // Создаём структуру параметров системы управления для использования в запросе
        ПараметрыСУ = Новый Структура;
        ПараметрыСУ.Вставить("baseurl", Настройки.baseurl);
        ПараметрыСУ.Вставить("port", Настройки.port);
        ПараметрыСУ.Вставить("useSSL", Настройки.useSSL);
        
        // Здесь мы не указываем authType, так как авторизация передается в теле запроса
        
        // Формируем тело запроса
        ДанныеАвторизации = Новый Структура;
        ДанныеАвторизации.Вставить("email", Логин);
        ДанныеАвторизации.Вставить("password", Пароль);
        
        // Выполняем запрос на авторизацию
        Ответ = ВыполнитьЗапросREST(
            "/api/auth/login",
            ПараметрыСУ,
            "POST",
            ДанныеАвторизации
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            ДанныеОтвета = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            // Сохраняем токен и данные пользователя
            Результат.Вставить("Токен", ДанныеОтвета.token);
            Результат.Вставить("Пользователь", ДанныеОтвета.user);
            
            // Сохраняем настройки авторизации в хранилище
            НастройкиАвторизации = Новый Структура;
            НастройкиАвторизации.Вставить("Пользователь", Логин);
            НастройкиАвторизации.Вставить("Пароль", Пароль);
            НастройкиАвторизации.Вставить("Токен", ДанныеОтвета.token);
            НастройкиАвторизации.Вставить("Авторизован", Истина);
            НастройкиАвторизации.Вставить("БазовыйURL", Настройки.baseurl);
            НастройкиАвторизации.Вставить("Порт", Настройки.port);
            НастройкиАвторизации.Вставить("ИспользоватьSSL", Настройки.useSSL);
            НастройкиАвторизации.Вставить("КлючAPI", ДанныеОтвета.user.apiKey);
            
            СохранитьОбщиеНастройки("RKWA1C", "Authorization", НастройкиАвторизации);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Успешная авторизация пользователя " + Логин);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка авторизации");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка авторизации");
            КонецЕсли;
            
            // Сбрасываем настройки авторизации
            НастройкиАвторизации = Новый Структура;
            НастройкиАвторизации.Вставить("Пользователь", Логин);
            НастройкиАвторизации.Вставить("Пароль", "");
            НастройкиАвторизации.Вставить("Токен", "");
            НастройкиАвторизации.Вставить("Авторизован", Ложь);
            НастройкиАвторизации.Вставить("БазовыйURL", Настройки.baseurl);
            НастройкиАвторизации.Вставить("Порт", Настройки.port);
            НастройкиАвторизации.Вставить("ИспользоватьSSL", Настройки.useSSL);
            НастройкиАвторизации.Вставить("КлючAPI", "");
            
            СохранитьОбщиеНастройки("RKWA1C", "Authorization", НастройкиАвторизации);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                "Ошибка авторизации пользователя " + Логин + ": " + Результат.Сообщение);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ВыполнитьАвторизацию: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

// Получить профиль текущего пользователя
//
// Параметры:
//  ПараметрыСУ - Структура - Параметры системы управления
//
// Возвращаемое значение:
//   Структура - Результат получения профиля:
//    * Успех - Булево - Признак успешного получения данных
//    * Профиль - Структура - Данные профиля пользователя (заполняется при успешном получении)
//    * Сообщение - Строка - Сообщение об ошибке (заполняется при неуспешном получении)
//    * КодСостояния - Число - HTTP код состояния
//
Функция ПолучитьПрофильПользователя(ПараметрыСУ) Экспорт
    
    Попытка
        // Проверка параметров авторизации
        Если НЕ ПараметрыСУ.Свойство("authType") Тогда
            // Если не указан тип авторизации, используем токен по умолчанию
            // при условии, что токен существует
            Если ПараметрыСУ.Свойство("token") И ЗначениеЗаполнено(ПараметрыСУ.token) Тогда
                ПараметрыСУ.Вставить("authType", "token");
            ИначеЕсли ПараметрыСУ.Свойство("apiKey") И ЗначениеЗаполнено(ПараметрыСУ.apiKey) Тогда
                ПараметрыСУ.Вставить("authType", "apiKey");
            Иначе
                ВызватьИсключение "Не указаны данные авторизации (токен или API ключ)";
            КонецЕсли;
        КонецЕсли;
        
        // Проверяем наличие необходимых параметров в зависимости от типа авторизации
        Если ПараметрыСУ.authType = "token" И (НЕ ПараметрыСУ.Свойство("token") ИЛИ ПустаяСтрока(ПараметрыСУ.token)) Тогда
            ВызватьИсключение "Не указан токен авторизации";
        ИначеЕсли ПараметрыСУ.authType = "apiKey" И (НЕ ПараметрыСУ.Свойство("apiKey") ИЛИ ПустаяСтрока(ПараметрыСУ.apiKey)) Тогда
            ВызватьИсключение "Не указан ключ API";
        КонецЕсли;
        
        // Выполняем запрос на получение профиля
        Ответ = ВыполнитьЗапросREST(
            "/api/auth/me",
            ПараметрыСУ,
            "GET"
        );
        
        // Формируем результат
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ответ.Успех);
        Результат.Вставить("КодСостояния", Ответ.КодСостояния);
        
        Если Ответ.Успех Тогда
            // Разбираем ответ сервера
            Профиль = ПрочитатьИзJSON(Ответ.ТелоОтвета);
            
            // Сохраняем данные профиля
            Результат.Вставить("Профиль", Профиль);
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Информация,,, 
                "Успешно получен профиль пользователя " + Профиль.email);
        Иначе
            // Разбираем ошибку
            Если ЗначениеЗаполнено(Ответ.ТелоОтвета) Тогда
                Попытка
                    ДанныеОшибки = ПрочитатьИзJSON(Ответ.ТелоОтвета);
                    Результат.Вставить("Сообщение", ДанныеОшибки.error);
                Исключение
                    Результат.Вставить("Сообщение", "Ошибка получения профиля пользователя");
                КонецПопытки;
            Иначе
                Результат.Вставить("Сообщение", "Ошибка получения профиля пользователя");
            КонецЕсли;
            
            // Если код ответа 401 или 403, значит проблемы с авторизацией
            Если Ответ.КодСостояния = 401 ИЛИ Ответ.КодСостояния = 403 Тогда
                // Сбрасываем флаг авторизации в настройках
                НастройкиАвторизации = ЗагрузитьОбщиеНастройки();
                НастройкиАвторизации.Авторизован = Ложь;
                СохранитьОбщиеНастройки("RKWA1C", "Authorization", НастройкиАвторизации);
                
                Результат.Вставить("Сообщение", "Ошибка авторизации. Необходимо повторно авторизоваться.");
            КонецЕсли;
            
            ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Предупреждение,,, 
                "Ошибка получения профиля пользователя: " + Результат.Сообщение);
        КонецЕсли;
        
        Возврат Результат;
        
    Исключение
        ИнфоОшибки = ИнформацияОбОшибке();
        ЗаписьЖурналаРегистрации("WhatsAppAPI", УровеньЖурналаРегистрации.Ошибка,,,
            "ПолучитьПрофильПользователя: " + ИнфоОшибки.Описание);
            
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("Сообщение", ИнфоОшибки.Описание);
        Результат.Вставить("КодСостояния", 0);
        
        Возврат Результат;
    КонецПопытки;
    
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

