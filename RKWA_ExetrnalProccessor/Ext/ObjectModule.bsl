Функция ПримерМассовойРассылки()
    
    // Создаем параметры подключения
    ИдИнстанса = "YOUR_INSTANCE_ID";
    ТипАутентификации = "apiKey";
    КлючАутентификации = "YOUR_API_KEY";
    СерверURL = "localhost";
    Порт = 3000;
    
    // Создаем структуру параметров
    ПараметрыСУ = СоздатьПараметрыСУ(
        ИдИнстанса,
        ТипАутентификации,
        КлючАутентификации,
        СерверURL,
        Порт
    );
    
    // Получаем список контактов для рассылки (пример)
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Контрагенты.Наименование КАК Наименование,
    |   Контрагенты.Телефон КАК Телефон
    |ИЗ
    |   Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |   Контрагенты.Группа = &Группа
    |   И Контрагенты.СогласиеНаРассылку = Истина";
    
    Запрос.УстановитьПараметр("Группа", "Оптовые клиенты");
    
    РезультатЗапроса = Запрос.Выполнить();
    
    Если РезультатЗапроса.Пустой() Тогда
        ВывестиСообщение("Контакты для рассылки не найдены.");
        Возврат Ложь;
    КонецЕсли;
    
    // Текст рассылки
    ТекстРассылки = 
        "Уважаемый клиент!" + Символы.ПС +
        "Сообщаем о специальном предложении для оптовых покупателей: при заказе от 50 000 руб. скидка 15%." + Символы.ПС +
        "Акция действует до конца месяца." + Символы.ПС +
        "Подробности на нашем сайте или у вашего менеджера." + Символы.ПС +
        "С уважением, команда компании.";
    
    // Статистика рассылки
    УспешноОтправлено = 0;
    ВсегоКонтактов = 0;
    
    // Отправляем сообщения
    Выборка = РезультатЗапроса.Выбрать();
    
    Пока Выборка.Следующий() Цикл
        ВсегоКонтактов = ВсегоКонтактов + 1;
        
        // Персонализируем сообщение
        ПерсонализированныйТекст = СтрЗаменить(ТекстРассылки, "Уважаемый клиент!", "Уважаемый " + Выборка.Наименование + "!");
        
        // Отправляем сообщение
        Результат = ОтправитьСообщение(
            Выборка.Телефон,
            ПерсонализированныйТекст,
            ПараметрыСУ
        );
        
        Если Результат.Успех Тогда
            УспешноОтправлено = УспешноОтправлено + 1;
            
            // Сохраняем информацию о рассылке
            ИдСообщения = ПрочитатьИзJSON(Результат.ТелоОтвета).id;
            
            МенеджерЗаписи = РегистрыСведений.РассылкиWhatsApp.СоздатьМенеджерЗаписи();
            МенеджерЗаписи.ИдентификаторРассылки = "BULK_2023_05_25";
            МенеджерЗаписи.Контрагент = Выборка.Ссылка;
            МенеджерЗаписи.Телефон = Выборка.Телефон;
            МенеджерЗаписи.Дата = ТекущаяДата();
            МенеджерЗаписи.ИдентификаторСообщения = ИдСообщения;
            МенеджерЗаписи.Успешно = Истина;
            МенеджерЗаписи.Записать();
        Иначе
            // Логируем ошибку отправки
            МенеджерЗаписи = РегистрыСведений.РассылкиWhatsApp.СоздатьМенеджерЗаписи();
            МенеджерЗаписи.ИдентификаторРассылки = "BULK_2023_05_25";
            МенеджерЗаписи.Контрагент = Выборка.Ссылка;
            МенеджерЗаписи.Телефон = Выборка.Телефон;
            МенеджерЗаписи.Дата = ТекущаяДата();
            МенеджерЗаписи.ИдентификаторСообщения = "";
            МенеджерЗаписи.Успешно = Ложь;
            МенеджерЗаписи.Ошибка = "Код: " + Результат.КодСостояния + ", Ответ: " + Результат.ТелоОтвета;
            МенеджерЗаписи.Записать();
        КонецЕсли;
        
    КонецЦикла;
    
    // Выводим статистику
    ВывестиСообщение("Результаты рассылки:");
    ВывестиСообщение("Всего контактов: " + ВсегоКонтактов);
    ВывестиСообщение("Успешно отправлено: " + УспешноОтправлено);
    ВывестиСообщение("Ошибок: " + (ВсегоКонтактов - УспешноОтправлено));
    
    Возврат (УспешноОтправлено > 0);
    
КонецФункции

// Вспомогательная функция для вывода сообщений
Процедура ВывестиСообщение(Сообщение) Экспорт
    
    // В реальной системе это может быть запись в журнал регистрации, вывод в консоль и т.д.
    Сообщить(Сообщение);
    
КонецПроцедуры


