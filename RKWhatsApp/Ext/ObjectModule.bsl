#Область События

// Подписаться на события: POST /api/v2/webhooks
//
// Единственный способ узнать о входящем сообщении. Ответ содержит поле
// secret — им платформа подписывает доставки, и другого экземпляра
// у него не будет: сохраните при получении.
//
// Параметры:
//   АдресПриёмника - Строка - полный URL вашего HTTP-сервиса
//   События - Массив - имена событий, пустой массив означает «все»
//   ИдНомера - Строка - пусто, если события нужны по всем номерам
//
Функция ПодписатьсяНаСобытия(Соединение, АдресПриёмника, События, ИдНомера = "") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("url", СокрЛП(АдресПриёмника));
	Тело.Вставить("events", ?(События = Неопределено, Новый Массив, События));
	Если НЕ ПустаяСтрока(ИдНомера) Тогда
		Тело.Вставить("instanceId", ИдНомера);
	КонецЕсли;

	Возврат ВыполнитьЗапрос(Соединение, "POST", "/api/v2/webhooks", Тело, "ПодписатьсяНаСобытия");

КонецФункции

#КонецОбласти

#Область РаботаСоЗначениями

// Привести номер телефона к виду, который принимает платформа: только
// цифры.
//
// Одна функция, а не две. Раньше их было две — ФорматироватьНомерТелефона
// вырезала перечисленные символы, ПравильноОтформатироватьТелефон
// оставляла цифры. Расходились они на всём, что не перечислено:
// неразрывный пробел из письма проходил через первую и ломал отправку.
//
Функция НормализоватьНомер(Знач Значение) Экспорт

	Текст = Строка(Значение);
	Результат = "";

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Прочитать дату из ответа платформы. Все даты в API — ISO 8601 в UTC.
//
// Возвращаемое значение:
//   Дата - пустая дата, если значения нет или оно не разбирается.
//
Функция ДатаИзJSON(Знач Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Значение) Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат ПрочитатьДатуJSON(Значение, ФорматДатыJSON.ISO);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Значение поля разобранного ответа с запасным вариантом.
//
// Ответ приходит соответствием, и обращение к отсутствующему ключу даёт
// Неопределено, а не ошибку: без этой обёртки любое новое поле в API
// оборачивалось бы падением формы вместо пустой ячейки.
//
Функция ЗначениеПоля(Источник, Имя, ЗначениеПоУмолчанию = "") Экспорт

	Если ТипЗнч(Источник) <> Тип("Соответствие") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Источник.Получить(Имя);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполнить один запрос к API.
//
// Возвращаемое значение:
//   Структура:
//    * Успех - Булево
//    * КодСостояния - Число - 0, если до сервера не дошли
//    * Данные - Произвольный - разобранное тело ответа
//    * Ошибка - Строка - текст для человека, пустой при успехе
//
Функция ВыполнитьЗапрос(Соединение, Метод, Путь, Тело = Неопределено, Операция = "")

	Результат = Новый Структура("Успех, КодСостояния, Данные, Ошибка", Ложь, 0, Неопределено, "");

	Если ПустаяСтрока(Соединение.Хост) Тогда
		Результат.Ошибка = "Не указан адрес платформы.";
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(Соединение.КлючAPI) Тогда
		Результат.Ошибка = "Не указан ключ API. Его выдают в портале, раздел «Доступ».";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЗащищённоеСоединение = ?(Соединение.Защищённое, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
		HTTPСоединение = Новый HTTPСоединение(Соединение.Хост, Соединение.Порт, , , ,
			Соединение.Таймаут, ЗащищённоеСоединение);

		Запрос = Новый HTTPЗапрос(Путь);

		// Ключ отправляется обоими способами, которые принимает платформа.
		// X-API-Key — то, что описано в договоре об интеграции; поле
		// Authorization без приставки Bearer понимали установки, где
		// заголовок X-API-Key ещё не поддержан. Один запрос вместо двух
		// попыток и разбора, какая из них сработала.
		Запрос.Заголовки.Вставить("X-API-Key", Соединение.КлючAPI);
		Запрос.Заголовки.Вставить("Authorization", Соединение.КлючAPI);
		Запрос.Заголовки.Вставить("Accept", "application/json");

		Если Тело <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json");
			// Без явного отказа от BOM 1С ставит его в начало тела, и
			// разбор JSON на стороне сервера падает на первом символе.
			Запрос.УстановитьТелоИзСтроки(ЗаписатьВJSON(Тело), КодировкаТекста.UTF8,
				ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;

		Ответ = HTTPСоединение.ВызватьHTTPМетод(Метод, Запрос);

		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Успех = (Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300);

		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		Если НЕ ПустаяСтрока(ТекстОтвета) Тогда
			Результат.Данные = ПрочитатьИзJSON(ТекстОтвета);
		КонецЕсли;

		Если НЕ Результат.Успех Тогда
			Результат.Ошибка = ТекстОтказа(Результат.КодСостояния, Результат.Данные);
		КонецЕсли;

	Исключение
		// Сюда попадают отказы сети и TLS: имени узла нет в DNS, сертификат
		// не принят, соединение закрыто. Текст платформы тут ни при чём.
		Результат.Ошибка = "Не удалось обратиться к платформе: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗаписатьВЖурнал(Операция, Метод, Результат);

	Возврат Результат;

КонецФункции

// Собрать все страницы списка, идя по курсору.
//
// Потолок в двадцать страниц стоит не от жадности: без него ошибка на
// стороне API, возвращающая один и тот же курсор, вешает сеанс
// пользователя молча.
//
Функция ВсеСтраницы(Соединение, Путь, Операция)

	Результат = Новый Структура("Успех, КодСостояния, Элементы, Ошибка", Ложь, 0, Новый Массив, "");

	Курсор = "";
	Страница = 0;

	Пока Страница < 20 Цикл

		Страница = Страница + 1;

		ПутьСтраницы = Путь + "?limit=100";
		Если НЕ ПустаяСтрока(Курсор) Тогда
			ПутьСтраницы = ПутьСтраницы + "&cursor="
				+ КодироватьСтроку(Курсор, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		Ответ = ВыполнитьЗапрос(Соединение, "GET", ПутьСтраницы, Неопределено, Операция);
		Результат.КодСостояния = Ответ.КодСостояния;

		Если НЕ Ответ.Успех Тогда
			Результат.Ошибка = Ответ.Ошибка;
			Возврат Результат;
		КонецЕсли;

		Элементы = ЗначениеПоля(Ответ.Данные, "items", Новый Массив);
		Если ТипЗнч(Элементы) = Тип("Массив") Тогда
			Для Каждого Элемент Из Элементы Цикл
				Результат.Элементы.Добавить(Элемент);
			КонецЦикла;
		КонецЕсли;

		Курсор = ЗначениеПоля(Ответ.Данные, "nextCursor", "");
		Если ПустаяСтрока(Курсор) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Разложить адрес платформы на узел, порт и признак TLS.
//
// Пользователь вводит один адрес, а HTTPСоединение требует три разных
// значения. Три поля в форме вместо одного — три способа ошибиться.
//
Функция РазобратьАдрес(Знач Адрес)

	Результат = Новый Структура("Хост, Порт, Защищённое", "", 443, Истина);

	Текст = НРег(СокрЛП(Адрес));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Если СтрНачинаетсяС(Текст, "https://") Тогда
		Текст = Сред(Текст, 9);
		Результат.Защищённое = Истина;
		Результат.Порт = 443;
	ИначеЕсли СтрНачинаетсяС(Текст, "http://") Тогда
		Текст = Сред(Текст, 8);
		Результат.Защищённое = Ложь;
		Результат.Порт = 80;
	КонецЕсли;

	// Путь и параметры отбрасываем: адреса методов обработка строит сама.
	Позиция = Найти(Текст, "/");
	Если Позиция > 0 Тогда
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;

	Позиция = Найти(Текст, ":");
	Если Позиция > 0 Тогда
		ТекстПорта = Сред(Текст, Позиция + 1);
		Текст = Лев(Текст, Позиция - 1);
		Попытка
			Результат.Порт = Число(ТекстПорта);
		Исключение
			// Порт не разобрался — остаётся порт по умолчанию для схемы.
			// Молчать здесь правильнее, чем падать: адрес проверит кнопка
			// «Проверить связь», и там отказ будет назван целиком.
		КонецПопытки;
	КонецЕсли;

	Результат.Хост = Текст;

	Возврат Результат;

КонецФункции

// Текст отказа для человека.
//
// Платформа отвечает {"error":{"code","message","correlationId"}}.
// Номер correlationId попадает в текст намеренно: по нему в журналах
// платформы находится ровно этот запрос, и разбор перестаёт быть
// гаданием.
//
Функция ТекстОтказа(КодСостояния, Данные)

	Если КодСостояния = 401 Тогда
		Возврат "Платформа не приняла ключ API (401). Проверьте ключ в портале, раздел «Доступ».";
	КонецЕсли;

	Сообщение = "";
	Опознавательный = "";

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Ошибка = Данные.Получить("error");
		Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
			Сообщение = ЗначениеПоля(Ошибка, "message", "");
			Опознавательный = ЗначениеПоля(Ошибка, "correlationId", "");
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Сообщение) Тогда
		Сообщение = "Платформа ответила отказом (" + Формат(КодСостояния, "ЧГ=0") + ").";
	Иначе
		Сообщение = Сообщение + " (" + Формат(КодСостояния, "ЧГ=0") + ")";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Опознавательный) Тогда
		Сообщение = Сообщение + Символы.ПС + "Номер обращения для поддержки: " + Опознавательный;
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

// Запись в журнал регистрации.
//
// В журнал не попадает ни текст сообщений, ни номера телефонов, ни имена
// контактов. Журнал читают администраторы базы, а переписку с клиентом
// им видеть незачем — и по закону, и по-человечески. Пишем имя операции,
// метод, код ответа и длину тела: этого хватает, чтобы понять, что
// произошло, и не хватает, чтобы прочитать чужую переписку.
//
Процедура ЗаписатьВЖурнал(Операция, Метод, Результат)

	Если ПустаяСтрока(Операция) Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Успех Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
		Текст = Операция + ": " + Метод + ", код " + Формат(Результат.КодСостояния, "ЧГ=0");
	Иначе
		Уровень = УровеньЖурналаРегистрации.Ошибка;
		// Текст отказа платформы сюда идти может: он описывает состояние
		// системы и не содержит данных переписки.
		Текст = Операция + ": " + Метод + ", код " + Формат(Результат.КодСостояния, "ЧГ=0")
			+ ". " + Результат.Ошибка;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("RK WhatsApp", Уровень, , , Текст);

КонецПроцедуры

// Сериализация в JSON.
//
Функция ЗаписатьВJSON(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

// Разбор JSON.
//
// Читаем в соответствие, а не в структуру: имена полей API — это чужой
// словарь, и однажды в нём появится ключ, который не является
// идентификатором 1С. Структура на таком ключе падает целиком.
//
Функция ПрочитатьИзJSON(Знач Текст)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		// Не JSON — например, страница ошибки от промежуточного прокси.
		// Вызывающий увидит пустые данные и текст отказа по коду ответа.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
