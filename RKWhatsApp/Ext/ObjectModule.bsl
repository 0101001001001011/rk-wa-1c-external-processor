////////////////////////////////////////////////////////////////////////////////
// Клиент API платформы RK WhatsApp версии 2.
//
// Обработка не хранит ни переписку, ни сообщения: их источником остаётся
// платформа. Прежняя версия пыталась вести собственное хранилище в
// регистрах сведений, которых в конфигурации заказчика нет, — такой код
// падал при первом же вызове и создавал видимость возможностей, которых
// не было.
//
// Входящие сообщения приходят вебхуком (POST на ваш HTTP-сервис), а не
// опросом: из внешней обработки фоновое задание не запустить, а опрос из
// обработчика ожидания живёт ровно до закрытия формы.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область Настройки

// Прочитать сохранённые настройки подключения.
//
// Возвращаемое значение:
//   Структура - АдресПлатформы, КлючAPI.
//
Функция Настройки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура("АдресПлатформы, КлючAPI", "", "");

	Сохранённое = ХранилищеОбщихНастроек.Загрузить("RKWhatsApp", "Подключение");
	Если ТипЗнч(Сохранённое) = Тип("Строка") И НЕ ПустаяСтрока(Сохранённое) Тогда
		Разобранное = ПрочитатьИзJSON(Сохранённое);
		Если ТипЗнч(Разобранное) = Тип("Соответствие") Тогда
			Результат.АдресПлатформы = ЗначениеПоля(Разобранное, "АдресПлатформы", "");
			Результат.КлючAPI = ЗначениеПоля(Разобранное, "КлючAPI", "");
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сохранить настройки подключения.
//
// Значений по умолчанию здесь нет намеренно: подставленные «admin/admin»
// выглядят как рабочая настройка и уводят от единственной верной мысли —
// ключ надо получить в портале, в разделе «Доступ».
//
Процедура СохранитьНастройки(АдресПлатформы, КлючAPI) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Настройки = Новый Структура;
	Настройки.Вставить("АдресПлатформы", СокрЛП(АдресПлатформы));
	Настройки.Вставить("КлючAPI", СокрЛП(КлючAPI));

	ХранилищеОбщихНастроек.Сохранить("RKWhatsApp", "Подключение", ЗаписатьВJSON(Настройки));

КонецПроцедуры

// Собрать параметры соединения из адреса платформы и ключа.
//
// Адрес установки в примерах вымышленный: эта же подпись стоит у поля формы,
// а подпись попадает в снимки экрана и в статьи — имя чужого стенда оттуда
// потом не убрать.
//
// Параметры:
//   АдресПлатформы - Строка - например, https://rkwa.example.com
//   КлючAPI - Строка - ключ из портала, раздел «Доступ»
//
// Возвращаемое значение:
//   Структура - Хост, Порт, Защищённое, КлючAPI, Таймаут.
//
Функция ОписаниеСоединения(АдресПлатформы, КлючAPI) Экспорт

	Разобранный = РазобратьАдрес(АдресПлатформы);

	Результат = Новый Структура;
	Результат.Вставить("Хост", Разобранный.Хост);
	Результат.Вставить("Порт", Разобранный.Порт);
	Результат.Вставить("Защищённое", Разобранный.Защищённое);
	Результат.Вставить("КлючAPI", СокрЛП(КлючAPI));
	Результат.Вставить("Таймаут", 60);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Номера

// Список номеров арендатора: GET /api/v2/instances
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Элементы (Массив соответствий).
//
Функция СписокНомеров(Соединение) Экспорт

	Возврат ВсеСтраницы(Соединение, "/api/v2/instances", "СписокНомеров");

КонецФункции

// Завести номер: POST /api/v2/instances
//
Функция СоздатьНомер(Соединение, Наименование) Экспорт

	Тело = Новый Структура("name", СокрЛП(Наименование));
	Возврат ВыполнитьЗапрос(Соединение, "POST", "/api/v2/instances", Тело, "СоздатьНомер");

КонецФункции

// Сведения об одном номере: GET /api/v2/instances/:id
//
Функция СведенияОНомере(Соединение, ИдНомера) Экспорт

	Путь = "/api/v2/instances/" + КодироватьСтроку(ИдНомера, СпособКодированияСтроки.КодировкаURL);
	Возврат ВыполнитьЗапрос(Соединение, "GET", Путь, Неопределено, "СведенияОНомере");

КонецФункции

// Запустить номер: POST /api/v2/instances/:id/start
//
// После запуска у номера появляется код для входа — до этого запрос кода
// отвечает 404, и это не ошибка настройки.
//
Функция ЗапуститьНомер(Соединение, ИдНомера) Экспорт

	Путь = "/api/v2/instances/" + КодироватьСтроку(ИдНомера, СпособКодированияСтроки.КодировкаURL) + "/start";
	Возврат ВыполнитьЗапрос(Соединение, "POST", Путь, Неопределено, "ЗапуститьНомер");

КонецФункции

// Остановить номер: POST /api/v2/instances/:id/stop
//
Функция ОстановитьНомер(Соединение, ИдНомера) Экспорт

	Путь = "/api/v2/instances/" + КодироватьСтроку(ИдНомера, СпособКодированияСтроки.КодировкаURL) + "/stop";
	Возврат ВыполнитьЗапрос(Соединение, "POST", Путь, Неопределено, "ОстановитьНомер");

КонецФункции

// Код для входа в WhatsApp: GET /api/v2/instances/:id/qr
//
// Платформа отдаёт и строку кода, и готовую картинку в поле image
// (data:image/png;base64,…). Картинку рисуем ею, а не сторонним
// сервисом: строка кода — это одноразовый пропуск к переписке, и
// отправлять её на чужой сайт ради красивой отрисовки нельзя.
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Данные, КодСостояния. При 404 Успех = Ложь,
//               а КодСостояния = 404: кода пока нет, надо повторить позже.
//
Функция КодДляВхода(Соединение, ИдНомера) Экспорт

	Путь = "/api/v2/instances/" + КодироватьСтроку(ИдНомера, СпособКодированияСтроки.КодировкаURL) + "/qr";
	Возврат ВыполнитьЗапрос(Соединение, "GET", Путь, Неопределено, "КодДляВхода");

КонецФункции

#КонецОбласти

#Область Сообщения

// Отправить текст: POST /api/v2/instances/:id/messages
//
// Параметры:
//   Получатель - Строка - номер в любом виде, приводится к цифрам
//   КлючПовтора - Строка - тот же ключ означает то же сообщение. Если
//       ваша система повторила вызов, не дождавшись ответа, человек
//       не получит второе сообщение. Пусто — платформа ключ не проверяет.
//
Функция ОтправитьТекст(Соединение, ИдНомера, Получатель, Текст, КлючПовтора = "") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("to", НормализоватьНомер(Получатель));
	Тело.Вставить("text", Текст);
	Если НЕ ПустаяСтрока(КлючПовтора) Тогда
		Тело.Вставить("idempotencyKey", КлючПовтора);
	КонецЕсли;

	Путь = "/api/v2/instances/" + КодироватьСтроку(ИдНомера, СпособКодированияСтроки.КодировкаURL) + "/messages";
	Возврат ВыполнитьЗапрос(Соединение, "POST", Путь, Тело, "ОтправитьТекст");

КонецФункции

// Отправить файл по ссылке: POST /api/v2/instances/:id/messages
//
// Файл платформа забирает по ссылке сама, поэтому ссылка должна быть
// доступна ей, а не только рабочему месту пользователя.
//
// Параметры:
//   Вид - Строка - document, image или video. Определяет, как файл
//       покажется получателю, а не то, что с ним можно сделать.
//
Функция ОтправитьФайлПоСсылке(Соединение, ИдНомера, Получатель, Ссылка, ИмяФайла,
	Подпись = "", Вид = "document", КлючПовтора = "") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("to", НормализоватьНомер(Получатель));
	Тело.Вставить("url", СокрЛП(Ссылка));
	Тело.Вставить("fileName", СокрЛП(ИмяФайла));
	Если НЕ ПустаяСтрока(Подпись) Тогда
		Тело.Вставить("caption", Подпись);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Вид) Тогда
		Тело.Вставить("as", Вид);
	КонецЕсли;
	Если НЕ ПустаяСтрока(КлючПовтора) Тогда
		Тело.Вставить("idempotencyKey", КлючПовтора);
	КонецЕсли;

	Путь = "/api/v2/instances/" + КодироватьСтроку(ИдНомера, СпособКодированияСтроки.КодировкаURL) + "/messages";
	Возврат ВыполнитьЗапрос(Соединение, "POST", Путь, Тело, "ОтправитьФайл");

КонецФункции

#КонецОбласти

