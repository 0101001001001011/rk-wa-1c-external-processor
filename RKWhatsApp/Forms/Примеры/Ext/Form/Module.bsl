////////////////////////////////////////////////////////////////////////////////
// Примеры работы с номером: отправка, переписка, контакты.
//
// Форма показывает, как вызываются методы обработки, — её код можно
// переносить в свои объекты почти дословно. Хранилища сообщений здесь
// нет: списки читаются с платформы и живут до закрытия формы.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("ИдНомера") ИЛИ ПустаяСтрока(Параметры.ИдНомера) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ИдНомера = Параметры.ИдНомера;
	ВидФайла = "document";

	Состояние = "Выберите вкладку. Отправка работает, только когда номер подключён.";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьТекст(Команда)

	ОтправитьТекстНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьФайл(Команда)

	ОтправитьФайлНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПереписки(Команда)

	ОбновитьПерепискиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСообщения(Команда)

	ТекущаяПереписка = Элементы.Переписки.ТекущиеДанные;
	Если ТекущаяПереписка = Неопределено Тогда
		Состояние = "Сначала выберите переписку в списке.";
		Возврат;
	КонецЕсли;

	ПоказатьСообщенияНаСервере(ТекущаяПереписка.Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКонтакты(Команда)

	ОбновитьКонтактыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьОбработку()

	Возврат РеквизитФормыВЗначение("Объект");

КонецФункции

&НаСервере
Функция ТекущееСоединение(Обработка)

	Настройки = Обработка.Настройки();
	Возврат Обработка.ОписаниеСоединения(Настройки.АдресПлатформы, Настройки.КлючAPI);

КонецФункции

&НаСервере
Процедура ОтправитьТекстНаСервере()

	Если ПустаяСтрока(Получатель) ИЛИ ПустаяСтрока(Текст) Тогда
		Состояние = "Укажите получателя и текст.";
		Возврат;
	КонецЕсли;

	Обработка = ПолучитьОбработку();

	// Ключ повтора делает отправку безопасной при повторном нажатии:
	// платформа опознает второй такой же вызов и не отправит человеку
	// второе сообщение. Здесь он новый на каждое нажатие — в учётной
	// системе на его месте должен быть идентификатор документа, из
	// которого сообщение уходит.
	КлючПовтора = Строка(Новый УникальныйИдентификатор);

	Ответ = Обработка.ОтправитьТекст(ТекущееСоединение(Обработка), ИдНомера, Получатель, Текст, КлючПовтора);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	// В состоянии показывается только идентификатор: текст сообщения
	// человеку и так виден в поле ввода, а вот в журналы и снимки экрана
	// он попадать не должен.
	Состояние = "Принято к отправке. Идентификатор сообщения: "
		+ Обработка.ЗначениеПоля(Ответ.Данные, "messageId", "");

КонецПроцедуры

&НаСервере
Процедура ОтправитьФайлНаСервере()

	Если ПустаяСтрока(Получатель) ИЛИ ПустаяСтрока(Ссылка) ИЛИ ПустаяСтрока(ИмяФайла) Тогда
		Состояние = "Для файла нужны получатель, ссылка и имя файла.";
		Возврат;
	КонецЕсли;

	Обработка = ПолучитьОбработку();
	КлючПовтора = Строка(Новый УникальныйИдентификатор);

	Ответ = Обработка.ОтправитьФайлПоСсылке(ТекущееСоединение(Обработка), ИдНомера,
		Получатель, Ссылка, ИмяФайла, Подпись, ВидФайла, КлючПовтора);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	Состояние = "Файл принят к отправке. Идентификатор сообщения: "
		+ Обработка.ЗначениеПоля(Ответ.Данные, "messageId", "");

КонецПроцедуры

&НаСервере
Процедура ОбновитьПерепискиНаСервере()

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.СписокПереписок(ТекущееСоединение(Обработка), ИдНомера);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	Объект.Переписки.Очистить();

	Для Каждого Элемент Из Ответ.Элементы Цикл
		НоваяСтрока = Объект.Переписки.Добавить();
		НоваяСтрока.Идентификатор = Обработка.ЗначениеПоля(Элемент, "id", "");
		НоваяСтрока.Заголовок = Обработка.ЗначениеПоля(Элемент, "title", "");
		НоваяСтрока.ЭтоГруппа = (Обработка.ЗначениеПоля(Элемент, "isGroup", Ложь) = Истина);
		НоваяСтрока.Обновлена = Обработка.ДатаИзJSON(Обработка.ЗначениеПоля(Элемент, "lastAt", ""));
	КонецЦикла;

	Состояние = "Переписок получено: " + Формат(Объект.Переписки.Количество(), "ЧГ=0") + ".";

КонецПроцедуры

&НаСервере
Процедура ПоказатьСообщенияНаСервере(ИдентификаторПереписки)

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.СообщенияПереписки(ТекущееСоединение(Обработка), ИдентификаторПереписки);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	ИдПереписки = ИдентификаторПереписки;
	Объект.Сообщения.Очистить();

	Для Каждого Элемент Из Ответ.Элементы Цикл
		НоваяСтрока = Объект.Сообщения.Добавить();
		НоваяСтрока.Идентификатор = Обработка.ЗначениеПоля(Элемент, "id", "");
		НоваяСтрока.Направление = ?(Обработка.ЗначениеПоля(Элемент, "direction", "") = "in", "входящее", "исходящее");
		НоваяСтрока.Текст = Обработка.ЗначениеПоля(Элемент, "body", "");
		НоваяСтрока.Статус = Обработка.ЗначениеПоля(Элемент, "status", "");
		НоваяСтрока.Время = Обработка.ДатаИзJSON(Обработка.ЗначениеПоля(Элемент, "at", ""));
	КонецЦикла;

	Состояние = "Сообщений получено: " + Формат(Объект.Сообщения.Количество(), "ЧГ=0") + ".";

КонецПроцедуры

&НаСервере
Процедура ОбновитьКонтактыНаСервере()

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.СписокКонтактов(ТекущееСоединение(Обработка), ИдНомера);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	Объект.Контакты.Очистить();

	Для Каждого Элемент Из Ответ.Элементы Цикл
		НоваяСтрока = Объект.Контакты.Добавить();
		НоваяСтрока.Идентификатор = Обработка.ЗначениеПоля(Элемент, "id", "");
		НоваяСтрока.Имя = Обработка.ЗначениеПоля(Элемент, "name", "");
		НоваяСтрока.Телефон = Обработка.ЗначениеПоля(Элемент, "phone", "");
		НоваяСтрока.Источник = ?(Обработка.ЗначениеПоля(Элемент, "nameSource", "") = "manual", "задано вручную", "из канала");
	КонецЦикла;

	Состояние = "Контактов получено: " + Формат(Объект.Контакты.Количество(), "ЧГ=0") + ".";

КонецПроцедуры

#КонецОбласти
