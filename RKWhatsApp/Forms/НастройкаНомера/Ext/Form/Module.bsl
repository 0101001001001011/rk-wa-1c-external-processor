////////////////////////////////////////////////////////////////////////////////
// Один номер: состояние и код для входа в WhatsApp.
//
// Код рисуется картинкой, которую отдаёт сама платформа. Прежняя версия
// собирала картинку сторонним сервисом api.qrserver.com, отправляя ему
// строку кода, — а строка кода это одноразовый пропуск к переписке:
// получивший её привязывает к номеру своё устройство.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Параметры.Свойство("ИдНомера") ИЛИ ПустаяСтрока(Параметры.ИдНомера) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ИдНомера = Параметры.ИдНомера;
	Если Параметры.Свойство("Наименование") Тогда
		Наименование = Параметры.Наименование;
	КонецЕсли;

	ПоказатьСтраницуКода("", "Код появляется после запуска номера.");
	ОбновитьСостояниеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьСостояниеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Запустить(Команда)

	ЗапуститьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)

	ОстановитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКод(Команда)

	ОбновитьКодНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьОбработку()

	Возврат РеквизитФормыВЗначение("Объект");

КонецФункции

&НаСервере
Функция ТекущееСоединение(Обработка)

	Настройки = Обработка.Настройки();
	Возврат Обработка.ОписаниеСоединения(Настройки.АдресПлатформы, Настройки.КлючAPI);

КонецФункции

&НаСервере
Процедура ОбновитьСостояниеНаСервере()

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.СведенияОНомере(ТекущееСоединение(Обработка), ИдНомера);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	ПринятьСведения(Обработка, Ответ.Данные);
	Состояние = ПодсказкаПоСостоянию();

КонецПроцедуры

&НаСервере
Процедура ЗапуститьНаСервере()

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.ЗапуститьНомер(ТекущееСоединение(Обработка), ИдНомера);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	ПринятьСведения(Обработка, Ответ.Данные);

	// Код появляется не мгновенно: платформа сначала поднимает соединение
	// с WhatsApp. Поэтому запуск не обещает код, а называет следующий шаг.
	Состояние = "Номер запускается. Через несколько секунд нажмите «Показать код для входа».";

КонецПроцедуры

&НаСервере
Процедура ОстановитьНаСервере()

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.ОстановитьНомер(ТекущееСоединение(Обработка), ИдНомера);

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	ПринятьСведения(Обработка, Ответ.Данные);
	ПоказатьСтраницуКода("", "Номер остановлен.");
	Состояние = "Номер остановлен. Отправка и приём сообщений не работают, пока он не запущен.";

КонецПроцедуры

&НаСервере
Процедура ОбновитьКодНаСервере()

	Обработка = ПолучитьОбработку();
	Ответ = Обработка.КодДляВхода(ТекущееСоединение(Обработка), ИдНомера);

	Если Ответ.КодСостояния = 404 Тогда
		// Это не отказ настройки: кода просто пока нет. Так отвечает
		// и уже подключённый номер — ему код больше не нужен.
		ПоказатьСтраницуКода("", "Кода сейчас нет: либо номер ещё не запущен, либо он уже подключён.");
		Состояние = "Кода сейчас нет. Запустите номер и повторите через несколько секунд.";
		Возврат;
	КонецЕсли;

	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	Картинка = Обработка.ЗначениеПоля(Ответ.Данные, "image", "");
	Истекает = Обработка.ЗначениеПоля(Ответ.Данные, "expiresAt", "");

	Если ПустаяСтрока(Картинка) Тогда
		ПоказатьСтраницуКода("", "Платформа не прислала картинку кода.");
		Состояние = "Платформа не прислала картинку кода. Повторите запрос.";
		Возврат;
	КонецЕсли;

	ПоказатьСтраницуКода("<img src=""" + Картинка + """ alt=""Код для входа"">",
		"WhatsApp на телефоне → Настройки → Связанные устройства → Привязка устройства.");

	СрокДействия = Обработка.ДатаИзJSON(Истекает);
	Если ЗначениеЗаполнено(СрокДействия) Тогда
		Состояние = "Код показан. Действует до " + Формат(СрокДействия, "ДФ='dd.MM.yyyy HH:mm:ss'") + " (UTC).";
	Иначе
		Состояние = "Код показан. Он живёт недолго — если не успели, нажмите кнопку ещё раз.";
	КонецЕсли;

КонецПроцедуры

// Перенести сведения о номере из ответа платформы в поля формы.
//
&НаСервере
Процедура ПринятьСведения(Обработка, Данные)

	Наименование = Обработка.ЗначениеПоля(Данные, "name", Наименование);
	Статус = Обработка.ЗначениеПоля(Данные, "status", "");
	Телефон = Обработка.ЗначениеПоля(Данные, "phoneNumber", "");
	ПоследняяОшибка = Обработка.ЗначениеПоля(Данные, "lastError", "");

КонецПроцедуры

// Что делать дальше — исходя из состояния номера.
//
&НаСервере
Функция ПодсказкаПоСостоянию()

	Если Статус = "connected" Тогда
		Возврат "Номер подключён. Можно отправлять сообщения — кнопка «Примеры» в форме настройки.";
	ИначеЕсли Статус = "stopped" Тогда
		Возврат "Номер остановлен. Нажмите «Запустить».";
	КонецЕсли;

	Возврат "Состояние номера: " + Статус + ". Если ждёте код — нажмите «Показать код для входа».";

КонецФункции

// Собрать страницу с кодом из макета.
//
&НаСервере
Процедура ПоказатьСтраницуКода(КартинкаHTML, Подпись)

	Обработка = ПолучитьОбработку();
	Макет = Обработка.ПолучитьМакет("QR");
	Текст = Макет.ПолучитьТекст();

	Текст = СтрЗаменить(Текст, "%КАРТИНКА%", КартинкаHTML);
	Текст = СтрЗаменить(Текст, "%ПОДПИСЬ%", Подпись);

	СтраницаКода = Текст;

КонецПроцедуры

#КонецОбласти
