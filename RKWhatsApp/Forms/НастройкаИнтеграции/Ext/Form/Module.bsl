////////////////////////////////////////////////////////////////////////////////
// Настройка интеграции: адрес платформы, ключ API и список номеров.
//
// Ключ API — единственный способ входа. Логина и пароля здесь нет
// намеренно: у платформы для них отдельный вход, дающий сверх нужного
// (управление пользователями, ролями, ключами), и держать эти права
// в учётной системе незачем.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = ПолучитьОбработку();
	Настройки = Обработка.Настройки();

	Объект.АдресПлатформы = Настройки.АдресПлатформы;
	Объект.КлючAPI = Настройки.КлючAPI;

	Если ПустаяСтрока(Объект.АдресПлатформы) И ПустаяСтрока(Объект.КлючAPI) Тогда
		Состояние = "Введите адрес платформы и ключ API, затем нажмите «Проверить связь»."
			+ Символы.ПС + "И то, и другое выдаёт портал RK WhatsApp, раздел «Доступ».";
	Иначе
		// Список не загружается сам: обращение к сети на открытии формы
		// задерживает её показ, а при недоступной платформе выглядит
		// как зависание 1С.
		Состояние = "Настройки прочитаны. Нажмите «Проверить связь», чтобы получить список номеров.";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	ПроверитьСвязьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	ОбновитьСписокНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНомер(Команда)

	Оповещение = Новый ОписаниеОповещения("ДобавитьНомерЗавершение", ЭтаФорма);
	ПоказатьВводСтроки(Оповещение, "", "Как назвать номер", 200);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНомерЗавершение(Наименование, ДополнительныеПараметры) Экспорт

	Если Наименование = Неопределено ИЛИ ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьНомерНаСервере(Наименование);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНомер(Команда)

	ТекущийНомер = Элементы.Номера.ТекущиеДанные;
	Если ТекущийНомер = Неопределено Тогда
		Состояние = "Сначала выберите номер в списке.";
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдНомера", ТекущийНомер.Идентификатор);
	ПараметрыФормы.Вставить("Наименование", ТекущийНомер.Наименование);

	// Ключ уникальности — идентификатор номера. Без него 1С считает формы с
	// одинаковым именем одной и той же и на второй номер показывает карточку
	// первого: ПриСозданииНаСервере у уже открытой формы не вызывается, и
	// человек видит чужое состояние с правильным заголовком. Замерено на
	// живой базе: второй номер открывался карточкой первого.
	ОткрытьФорму("ВнешняяОбработка.RKWhatsApp.Форма.НастройкаНомера", ПараметрыФормы,
		ЭтаФорма, ТекущийНомер.Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПримеры(Команда)

	ТекущийНомер = Элементы.Номера.ТекущиеДанные;
	Если ТекущийНомер = Неопределено Тогда
		Состояние = "Сначала выберите номер в списке.";
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдНомера", ТекущийНомер.Идентификатор);

	// Ключ уникальности по той же причине, что и у карточки номера: иначе
	// примеры для второго номера откроются формой, привязанной к первому.
	ОткрытьФорму("ВнешняяОбработка.RKWhatsApp.Форма.Примеры", ПараметрыФормы,
		ЭтаФорма, ТекущийНомер.Идентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьОбработку()

	Возврат РеквизитФормыВЗначение("Объект");

КонецФункции

&НаСервере
Процедура СохранитьНаСервере()

	Обработка = ПолучитьОбработку();
	Обработка.СохранитьНастройки(Объект.АдресПлатформы, Объект.КлючAPI);

	Состояние = "Настройки сохранены. Они общие для всей информационной базы.";

КонецПроцедуры

&НаСервере
Процедура ПроверитьСвязьНаСервере()

	// Проверка связи — это и есть первый настоящий запрос. Отдельного
	// метода «проверить ключ» у платформы нет, и придумывать его значило бы
	// проверять не то, чем обработка пользуется.
	ЗагрузитьНомера("Связь есть.");

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокНаСервере()

	ЗагрузитьНомера("Список обновлён.");

КонецПроцедуры

&НаСервере
Процедура ДобавитьНомерНаСервере(Наименование)

	Обработка = ПолучитьОбработку();
	Соединение = Обработка.ОписаниеСоединения(Объект.АдресПлатформы, Объект.КлючAPI);

	Ответ = Обработка.СоздатьНомер(Соединение, Наименование);
	Если НЕ Ответ.Успех Тогда
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	ЗагрузитьНомера("Номер заведён. Откройте его и нажмите «Запустить», чтобы получить код для входа.");

КонецПроцедуры

// Перечитать список номеров с платформы.
//
// Параметры:
//   СообщениеОбУспехе - Строка - что показать человеку, если всё вышло.
//
&НаСервере
Процедура ЗагрузитьНомера(СообщениеОбУспехе)

	Обработка = ПолучитьОбработку();
	Соединение = Обработка.ОписаниеСоединения(Объект.АдресПлатформы, Объект.КлючAPI);

	Ответ = Обработка.СписокНомеров(Соединение);

	Если НЕ Ответ.Успех Тогда
		Объект.СвязьПроверена = Ложь;
		Состояние = Ответ.Ошибка;
		Возврат;
	КонецЕсли;

	Объект.Номера.Очистить();

	Для Каждого Элемент Из Ответ.Элементы Цикл
		НоваяСтрока = Объект.Номера.Добавить();
		НоваяСтрока.Идентификатор = Обработка.ЗначениеПоля(Элемент, "id", "");
		НоваяСтрока.Наименование = Обработка.ЗначениеПоля(Элемент, "name", "");
		НоваяСтрока.Статус = Обработка.ЗначениеПоля(Элемент, "status", "");
		НоваяСтрока.Телефон = Обработка.ЗначениеПоля(Элемент, "phoneNumber", "");
		НоваяСтрока.ПоследняяОшибка = Обработка.ЗначениеПоля(Элемент, "lastError", "");
		НоваяСтрока.ДатаСоздания = Обработка.ДатаИзJSON(Обработка.ЗначениеПоля(Элемент, "createdAt", ""));
		НоваяСтрока.ДатаОбновления = Обработка.ДатаИзJSON(Обработка.ЗначениеПоля(Элемент, "updatedAt", ""));
	КонецЦикла;

	Объект.СвязьПроверена = Истина;
	Состояние = СообщениеОбУспехе + " Номеров получено: " + Формат(Объект.Номера.Количество(), "ЧГ=0") + ".";

КонецПроцедуры

#КонецОбласти
